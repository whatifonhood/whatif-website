{
  "name": "whatif-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website for What $IF ($IF) on Robinhood Chain.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run questions && npm run docs && npm run roadmap && npm run build",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:install": "playwright install chromium",
    "og": "node tools/render-og.mjs",
    "cards": "node tools/render-og.mjs --memes --coins",
    "coincards": "node tools/render-og.mjs --coins",
    "burns": "node tools/build-burns.mjs",
    "headers": "node tools/build-headers.mjs",
    "tweets": "node tools/build-tweets.mjs",
    "memes": "node tools/build-memes.mjs",
    "history": "node tools/build-coin-history.mjs",
    "snapshot": "node tools/update-snapshot.mjs",
    "serve": "node tools/serve-dist.mjs",
    "favicons": "node tools/build-favicons.mjs",
    "coins": "node tools/build-coins.mjs",
    "coinlist": "node tools/build-coin-list.mjs",
    "brandkit": "node tools/build-brand-kit.mjs",
    "questions": "node tools/check-questions.mjs",
    "machine": "node tools/check-machine.mjs",
    "history:clean": "node tools/clean-coin-history.mjs",
    "holders": "node tools/build-holders.mjs",
    "docs": "node tools/check-docs.mjs",
    "roadmap": "node tools/check-roadmap.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
