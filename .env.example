# Build-time only. Nothing in here is ever sent to the browser.
#
# The site itself runs with no environment variables at all — this file exists
# only for `npm run history`, which rebuilds the What $IF Machine's coin data.
#
# Copy to `.env` and fill in. `.env` is gitignored.

# CoinGecko API key. Optional.
#
# Without one, the machine's coins are limited to what Binance lists, because
# CoinGecko put price history behind a key. With one, history comes from
# CoinGecko instead and the set can include coins that never listed on a major
# exchange — which is most memecoins.
#
# Get a free demo key at https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Which CoinGecko plan the key belongs to: "demo" (free) or "pro".
COINGECKO_PLAN=demo

# How many coins to include. More coins means a longer build and a larger
# public/machine folder; roughly 25 KB per coin.
#
# The ceiling is what the search can offer, not what it will find: a coin is
# only included if a source has at least six months of monthly prices for it and
# it does not look like a stablecoin. Expect roughly two thirds of this number.
MACHINE_COIN_COUNT=600