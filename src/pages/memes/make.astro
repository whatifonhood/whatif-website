---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE } from '../../config/site.ts';
import {
  MEME_TEMPLATES,
  POSES,
  BACKDROPS,
  DEFAULT_TEMPLATE_ID,
} from '../../config/meme-templates.ts';
import { getCopy } from '../../content/index.ts';
import Icons from '../../components/ui/Icons.astro';

/**
 * The meme generator.
 *
 * The page is only the controls; every pixel is drawn by src/scripts/meme-maker.ts
 * on the visitor's own device. Nothing is uploaded and nothing is stored, which
 * is why there is no server anywhere in this feature.
 */
const locale = 'en' as const;
const copy = getCopy(locale);
const page = copy.pages.memeMaker;

const start = MEME_TEMPLATES.find((t) => t.id === DEFAULT_TEMPLATE_ID) ?? MEME_TEMPLATES[0]!;

/** Handed to the script as JSON so the generated inputs get localised labels. */
const fieldLabels = JSON.stringify(page.fields);
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={copy.vaultTeaser.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-maker.jpg`}
>
  <div
    data-maker
    data-template={start.id}
    data-field-labels={fieldLabels}
    data-share-text={page.shareText}
    data-label-saved={page.saved}
    data-label-failed={page.failed}
    class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8"
  >
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-12">
      <!-- Preview. Sticks to the top on a phone so it stays visible while typing. -->
      <div
        class="sticky top-16 z-10 -mx-5 bg-void/95 px-5 py-3 backdrop-blur sm:-mx-8 sm:px-8 lg:static lg:mx-0 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none"
      >
        <div class="mx-auto max-w-lg lg:sticky lg:top-24 lg:max-w-none">
          <canvas
            data-maker-canvas
            width="1200"
            height="1200"
            role="img"
            aria-label={page.title}
            class="w-full rounded-xl border border-line bg-surface shadow-2xl"></canvas>

          <div class="mt-3 hidden items-center justify-between gap-3 lg:flex">
            <p class="text-xs text-faint">{page.privacy}</p>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="flex flex-col gap-7">
        <!-- Format -->
        <fieldset>
          <legend class="maker-legend">{page.templateLabel}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              MEME_TEMPLATES.map((template) => (
                <button
                  type="button"
                  data-template={template.id}
                  aria-pressed={template.id === start.id ? 'true' : 'false'}
                  class="maker-chip"
                >
                  {page.templates[template.id] ?? template.id}
                </button>
              ))
            }
          </div>
        </fieldset>

        <!-- The words. Built by the script, because the fields depend on the format. -->
        <div data-maker-fields class="flex flex-col gap-4"></div>

        <!-- Pose -->
        <fieldset data-maker-poses>
          <legend class="maker-legend">{page.poseLabel}</legend>
          <div class="mt-3 grid grid-cols-4 gap-2">
            {
              POSES.map((pose) => (
                <button
                  type="button"
                  data-pose={pose}
                  aria-pressed={pose === 'arms-crossed' ? 'true' : 'false'}
                  class="maker-pose"
                  title={page.poses[pose]}
                >
                  <img
                    src={`/machine/poses/${pose}.webp`}
                    alt={page.poses[pose]}
                    width="140"
                    height="140"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="maker-pose-label">{page.poses[pose]}</span>
                </button>
              ))
            }
          </div>
        </fieldset>

        <!-- Backdrop -->
        <fieldset data-maker-backdrops>
          <legend class="maker-legend">{page.backdropLabel}</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              BACKDROPS.map((backdrop) => (
                <button
                  type="button"
                  data-backdrop={backdrop}
                  aria-pressed={backdrop === start.backdrop ? 'true' : 'false'}
                  class="maker-chip"
                >
                  {page.backdrops[backdrop] ?? backdrop}
                </button>
              ))
            }
          </div>
        </fieldset>

        <!-- Actions -->
        <div class="flex flex-col gap-3 border-t border-line pt-6">
          <div class="flex flex-wrap gap-3">
            <button type="button" data-maker-download class="maker-primary">
              {page.download}
            </button>
            <button type="button" data-maker-share class="maker-secondary">
              <Icons name="x" size={14} />
              {page.share}
            </button>
            <button type="button" data-maker-shuffle class="maker-secondary">
              {page.shuffle}
            </button>
          </div>
          <p data-maker-status role="status" aria-live="polite" class="min-h-5 text-xs text-lime">
          </p>
          <p class="text-xs text-faint lg:hidden">{page.privacy}</p>
        </div>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { initMemeMaker } from '../../scripts/meme-maker.ts';

  initMemeMaker('en');
</script>

<style>
  .maker-legend {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .maker-chip {
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .maker-chip:hover {
    border-color: color-mix(in srgb, var(--color-lime) 50%, transparent);
    color: var(--color-ink);
  }
  .maker-chip[aria-pressed='true'] {
    border-color: var(--color-lime);
    background: color-mix(in srgb, var(--color-lime) 12%, transparent);
    color: var(--color-lime);
  }

  .maker-pose {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.5rem 0.25rem 0.4rem;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .maker-pose img {
    height: 3.25rem;
    width: auto;
  }
  .maker-pose-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .maker-pose:hover {
    border-color: color-mix(in srgb, var(--color-lime) 45%, transparent);
  }
  .maker-pose[aria-pressed='true'] {
    border-color: var(--color-lime);
    background: color-mix(in srgb, var(--color-lime) 10%, transparent);
  }
  .maker-pose[aria-pressed='true'] .maker-pose-label {
    color: var(--color-lime);
  }

  .maker-primary {
    border-radius: 999px;
    background: var(--color-lime);
    padding: 0.85rem 1.6rem;
    font-weight: 600;
    color: var(--color-void);
    transition: filter 0.15s ease;
  }
  .maker-primary:hover {
    filter: brightness(1.08);
  }

  .maker-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.85rem 1.4rem;
    font-weight: 600;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }
  .maker-secondary:hover {
    border-color: color-mix(in srgb, var(--color-lime) 50%, transparent);
  }

  fieldset[hidden] {
    display: none;
  }
</style>

<style is:global>
  /*
   * The text inputs are created by the script when the format changes, so their
   * styles cannot be scoped — Astro only scopes what is in the template above,
   * and runtime-built elements would render unstyled.
   */
  .maker-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .maker-field-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-lime);
  }

  .maker-input {
    width: 100%;
    resize: none;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.75rem 0.9rem;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-ink);
    transition: border-color 0.15s ease;
  }

  .maker-input::placeholder {
    color: var(--color-faint);
  }

  .maker-input:focus {
    border-color: var(--color-lime);
    outline: 2px solid color-mix(in srgb, var(--color-lime) 35%, transparent);
    outline-offset: 1px;
  }
</style>
