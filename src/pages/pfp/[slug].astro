---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { COINS, COIN_TIERS } from '../../config/coins.ts';
import { SITE } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import Button from '../../components/ui/Button.astro';
import Icons from '../../components/ui/Icons.astro';

/**
 * A page for each coin, so a shared link unfurls with that coin's own picture
 * and name rather than a generic card.
 *
 * The standalone module did this with 101 hand-generated HTML files that
 * immediately redirected. These are real pages: a person who follows the link
 * sees the coin, and can pull their own from here.
 */
export const getStaticPaths = (() =>
  COINS.map((coin) => ({
    params: { slug: coin.slug },
    props: { coin },
  }))) satisfies GetStaticPaths;

const { coin } = Astro.props;

const locale = 'en' as const;
const copy = getCopy(locale);
const page = copy.pages.pfp;

const tierLabel = page.tiers[coin.tier];
const description = `${coin.name} — a ${tierLabel} $IF coin. ${page.intro}`;

const shareUrl = new URL('https://x.com/intent/post');
shareUrl.searchParams.set('text', page.shareText(coin.name, tierLabel));
shareUrl.searchParams.set('url', `${SITE.url}/pfp/${coin.slug}`);
---

<PageLayout
  locale={locale}
  title={`${coin.name} — ${tierLabel} $IF coin`}
  description={description}
  eyebrow={copy.pfpTeaser.eyebrow}
  heading={{ lead: coin.name, accent: tierLabel }}
  intro={page.intro}
  socialImage={`${SITE.url}/coins/og/${coin.slug}.jpg`}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-14 sm:px-8">
    <div class="flex flex-col items-center">
      <div class="coin-frame" data-tier={coin.tier}>
        <img
          src={`/coins/full/${coin.slug}.webp`}
          alt={`${coin.name}, a ${tierLabel} $IF coin`}
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-full"
        />
      </div>

      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
        {tierLabel} · {COIN_TIERS[coin.tier].weight}% {page.odds}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/pfp/" size="lg">
          {page.openGenerator}
          <Icons name="arrow-up-right" size={16} />
        </Button>
        <Button
          href={`/coins/full/${coin.slug}.png`}
          variant="secondary"
          size="lg"
          download={`what-if-${coin.slug}.png`}
        >
          {page.download}
        </Button>
        <Button
          href={shareUrl.toString()}
          variant="secondary"
          size="lg"
          external
          externalLabel={copy.common.externalLink}
        >
          <Icons name="x" size={14} />
          {page.postOnX}
        </Button>
      </div>
    </div>
  </div>
</PageLayout>

<style>
  .coin-frame {
    position: relative;
    width: min(100%, 340px);
  }
  .coin-frame::before {
    content: '';
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--tier-glow, rgb(143 206 2 / 0.28)), transparent 68%);
    animation: glow 4s ease-in-out infinite;
  }
  .coin-frame img {
    position: relative;
  }
  [data-tier='uncommon'] {
    --tier-glow: rgb(196 220 67 / 0.3);
  }
  [data-tier='rare'] {
    --tier-glow: rgb(91 200 245 / 0.32);
  }
  [data-tier='legendary'] {
    --tier-glow: rgb(228 217 142 / 0.42);
  }
</style>
