---
import type { GetStaticPaths } from 'astro';
import MemeMaker from '../../../components/pages/MemeMaker.astro';
import { LOCALES, type Locale } from '../../../config/site.ts';

/**
 * MemeMaker in every language except English, which is served from the root.
 *
 * The body lives in the component so the two routes cannot drift apart.
 */
export const getStaticPaths = (() =>
  LOCALES.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<MemeMaker locale={locale} />
