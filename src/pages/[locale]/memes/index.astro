---
import type { GetStaticPaths } from 'astro';
import Vault from '../../../components/pages/Vault.astro';
import { LOCALES, type Locale } from '../../../config/site.ts';

/**
 * Vault in every language except English, which is served from the root.
 *
 * The body lives in the component so the two routes cannot drift apart.
 */
export const getStaticPaths = (() =>
  LOCALES.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<Vault locale={locale} />
