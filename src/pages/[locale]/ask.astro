---
import type { GetStaticPaths } from 'astro';
import Ask from '../../components/pages/Ask.astro';
import { LOCALES, type Locale } from '../../config/site.ts';

/**
 * The generator in every language except English, which is served from the root.
 *
 * The interface is translated; the questions themselves are English, because
 * generating grammatical sentences by combination in a language nobody here can
 * check would produce confident nonsense.
 */
export const getStaticPaths = (() =>
  LOCALES.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<Ask locale={locale} />
