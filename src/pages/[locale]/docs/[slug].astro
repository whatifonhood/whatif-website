---
import type { GetStaticPaths } from 'astro';
import DocsPage from '../../../components/pages/DocsPage.astro';
import { DOCS_ORDER } from '../../../config/docs.ts';
import { LOCALES, type Locale } from '../../../config/site.ts';

/**
 * One page of the white paper in every language except English.
 *
 * Built from the reading order rather than from the files that happen to exist,
 * so a missing translation is a build failure in `npm run docs` rather than a
 * page that quietly disappears from the sidebar.
 */
export const getStaticPaths = (() =>
  LOCALES.filter((locale) => locale !== 'en').flatMap((locale) =>
    DOCS_ORDER.map((slug) => ({ params: { locale, slug }, props: { locale, slug } })),
  )) satisfies GetStaticPaths;

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
---

<DocsPage locale={locale} slug={slug} />
