---
import type { GetStaticPaths } from 'astro';
import LearnIndex from '../../../components/pages/LearnIndex.astro';
import { LOCALES, type Locale } from '../../../config/site.ts';

/**
 * The Learn index in every language except English, which is served from the
 * root.
 */
export const getStaticPaths = (() =>
  LOCALES.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<LearnIndex locale={locale} />
