---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import Icons from '../../components/ui/Icons.astro';
import CoinSpark from '../../components/ui/CoinSpark.astro';
import { SITE } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import { formatUsd, formatUsdExact } from '../../lib/format.ts';
import {
  coinHistory,
  machineCoins,
  returnsTable,
  MIN_MONTHS_FOR_PAGE,
  type PricePoint,
  type Row,
} from '../../lib/coin-history.ts';

/**
 * A page per coin, answering the one question people actually type.
 *
 * Somebody searching "what if I had bought dogecoin in 2019" wants a number,
 * not a calculator to operate. These pages carry the answer already worked out
 * in the HTML, from the same committed history the Machine uses, so the page is
 * complete before any JavaScript runs and a crawler reads real figures.
 *
 * Only coins with a year of history get one: below that the table has a single
 * row and the page has nothing to say.
 */
export const getStaticPaths = (() => {
  const AMOUNT = 500;

  return machineCoins().flatMap((coin) => {
    const history = coinHistory(coin.symbol);
    if (!history || history.length < MIN_MONTHS_FOR_PAGE) return [];

    return [
      {
        params: { symbol: coin.symbol.toLowerCase() },
        props: { coin, history, rows: returnsTable(history, AMOUNT), amount: AMOUNT },
      },
    ];
  });
}) satisfies GetStaticPaths;

type Props = {
  coin: { symbol: string; name: string; rank: number };
  history: PricePoint[];
  rows: Row[];
  amount: number;
};

const { coin, history, rows, amount } = Astro.props as Props;

const locale = 'en' as const;
const copy = getCopy(locale);
const page = copy.pages.machine;

const now = history.at(-1)!;
const first = history[0]!;
const best = [...rows].sort((a, b) => b.multiple - a.multiple)[0]!;

/** "2019-04" → "April 2019". */
const monthName = (key: string) =>
  new Date(`${key.length > 7 ? key : `${key}-01`}T00:00:00Z`).toLocaleDateString(locale, {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const showMultiple = (value: number) =>
  value >= 100 ? `${Math.round(value).toLocaleString(locale)}×` : `${value.toFixed(1)}×`;

const title = `What if you had bought ${coin.name}?`;
const description =
  `${formatUsd(amount, locale)} of ${coin.name} in ${monthName(best.month)} would be ` +
  `${formatUsdExact(best.value, locale)} today — ${showMultiple(best.multiple)}. ` +
  `Every month since ${monthName(first[0])}, priced from the chain.`;

/** Prefills the full Machine with this coin. */
const machineUrl = `/machine/?coin=${encodeURIComponent(coin.symbol)}&amount=${amount}`;

const shareUrl = new URL('https://x.com/intent/post');
shareUrl.searchParams.set(
  'text',
  `${formatUsd(amount, locale)} of ${coin.name} in ${monthName(best.month)} → ` +
    `${formatUsdExact(best.value, locale)}. Still asking.`,
);
shareUrl.searchParams.set('url', `${SITE.url}/machine/${coin.symbol.toLowerCase()}/`);
---

<PageLayout
  locale={locale}
  title={title}
  description={description}
  eyebrow={page.title}
  heading={{ lead: `What $IF you had bought`, accent: coin.name }}
  intro={`${formatUsd(amount, locale)} at its best entry here — ${monthName(best.month)} — would be ${formatUsdExact(best.value, locale)} today. Priced monthly since ${monthName(first[0])}.`}
  socialImage={`${SITE.url}/og-machine.jpg`}
>
  <div class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8">
    <div class="flex items-center gap-3">
      <img
        src={`/machine/logos/${coin.symbol}.webp`}
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 shrink-0 rounded-full"
        loading="eager"
      />
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">{coin.symbol}</p>
      <a
        href="/machine/"
        class="ml-auto font-mono text-[11px] uppercase tracking-[0.16em] text-faint transition-colors hover:text-lime"
      >
        All {machineCoins().length} coins
      </a>
    </div>

    <CoinSpark history={history} />

    <h2 class="display-heading mt-12 text-2xl sm:text-3xl">
      {formatUsd(amount, locale)}, at every point you could have started
    </h2>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full min-w-[34rem] border-collapse text-left font-mono text-sm">
        <thead>
          <tr class="border-b border-line text-[11px] uppercase tracking-[0.14em] text-faint">
            <th scope="col" class="py-3 pr-4 font-normal">If you had bought</th>
            <th scope="col" class="py-3 pr-4 font-normal">Price then</th>
            <th scope="col" class="py-3 pr-4 text-right font-normal">It would be worth</th>
            <th scope="col" class="py-3 text-right font-normal">Multiple</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-line/60">
                <th scope="row" class="py-3 pr-4 font-normal text-ink">
                  {monthName(row.month)}
                </th>
                <td class="py-3 pr-4 tabular-nums text-muted">{formatUsd(row.price, locale)}</td>
                <td
                  class="py-3 pr-4 text-right tabular-nums font-semibold"
                  class:list={[row.multiple >= 1 ? 'text-lime' : 'text-warn']}
                >
                  {formatUsdExact(row.value, locale)}
                </td>
                <td class="py-3 text-right tabular-nums text-muted">
                  {showMultiple(row.multiple)}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-4 font-mono text-[11px] leading-relaxed text-faint">
      Price today: {formatUsd(now[1], locale)} ({monthName(now[0])}). {page.disclaimer}
    </p>

    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={machineUrl} variant="primary">
        Try your own amount and date
        <Icons name="arrow-up-right" size={16} />
      </Button>
      <Button href={shareUrl.toString()} variant="ghost" external> Post this </Button>
    </div>
  </div>
</PageLayout>
