---
import type { GetStaticPaths } from 'astro';
import LearnArticle from '../../components/pages/LearnArticle.astro';
import { getLearnPages } from '../../lib/learn.ts';

/** The English Learn pages, served from the root. */
export const getStaticPaths = (() =>
  getLearnPages('en').map((page) => ({
    params: { slug: page.slug },
    props: { slug: page.slug },
  }))) satisfies GetStaticPaths;

const { slug } = Astro.props as { slug: string };
---

<LearnArticle locale="en" slug={slug} />
