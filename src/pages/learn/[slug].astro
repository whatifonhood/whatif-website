---
import type { GetStaticPaths, MarkdownInstance } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import { getLearnPages } from '../../lib/learn.ts';

/**
 * One Learn page.
 *
 * The Markdown renders through Astro's own pipeline, so the prose stays prose
 * and nothing is injected as HTML from outside this repository.
 */
type LearnModule = MarkdownInstance<Record<string, unknown>>;
const entries = import.meta.glob<LearnModule>('../../learn/*.md', { eager: true });

export const getStaticPaths = (() =>
  Object.keys(import.meta.glob('../../learn/*.md', { eager: true })).map((path) => ({
    params: { slug: path.split('/').pop()?.replace(/\.md$/, '') ?? '' },
  }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const locale = 'en' as const;
const copy = getCopy(locale);

const all = getLearnPages();
const entry = all.find((page) => page.slug === slug);
const index = all.findIndex((page) => page.slug === slug);
const next = all[index + 1];

const key = Object.keys(entries).find((path) => path.endsWith(`/${slug}.md`));
const Content = key ? entries[key]?.Content : undefined;
---

<PageLayout
  locale={locale}
  title={entry?.title ?? copy.pages.learn.title}
  description={entry?.summary ?? copy.pages.learn.intro}
  eyebrow={copy.pages.learn.eyebrow}
  heading={{ lead: entry?.title ?? '', accent: '' }}
  intro={entry?.summary ?? ''}
  socialImage={`${SITE.url}/og-default.jpg`}
>
  <div class="mx-auto w-full max-w-2xl px-5 py-12 sm:px-8">
    <article class="prose-if">
      {Content && <Content />}
    </article>

    <nav class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-8">
      <a
        href="/learn/"
        class="font-mono text-[11px] uppercase tracking-wider text-faint hover:text-lime"
      >
        {copy.pages.learn.backToIndex}
      </a>
      {
        next && (
          <a
            href={`/learn/${next.slug}/`}
            class="font-mono text-[11px] uppercase tracking-wider text-lime hover:underline"
          >
            {copy.pages.learn.next} {next.title}
          </a>
        )
      }
    </nav>
  </div>
</PageLayout>

<style is:global>
  /*
   * Markdown produces its own elements, so these rules cannot be scoped —
   * Astro only scopes what appears in a component's own template.
   */
  .prose-if h2 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .prose-if p {
    margin-bottom: 1.15rem;
    line-height: 1.75;
    color: var(--color-muted);
  }
  .prose-if strong {
    color: var(--color-ink);
    font-weight: 600;
  }
  .prose-if ul {
    margin: 0 0 1.15rem 1.1rem;
    list-style: disc;
  }
  .prose-if li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .prose-if li::marker {
    color: var(--color-faint);
  }
  .prose-if a {
    color: var(--color-lime);
    text-underline-offset: 3px;
  }
  .prose-if a:hover {
    text-decoration: underline;
  }
  .prose-if code {
    overflow-wrap: anywhere;
    border-radius: 4px;
    background: var(--color-surface-2);
    padding: 0.1em 0.4em;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-ink);
  }
</style>
