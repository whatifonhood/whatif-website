---
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import Icons from '../ui/Icons.astro';
import type { SplitHeading } from '../../content/types.ts';
import type { ImageMetadata } from 'astro';

/**
 * A promo block pointing at one of the tools (the generator, the meme vault).
 * Shared by both so the two never drift apart visually.
 */
interface Props {
  id: string;
  eyebrow: string;
  heading: SplitHeading;
  body: string;
  cta: string;
  href: string;
  /** Tiles shown beside the copy. */
  images: ImageMetadata[];
  imageAlt: string;
  /** Flips the image to the other side, so consecutive teasers alternate. */
  reverse?: boolean;
}

const { id, eyebrow, heading, body, cta, href, images, imageAlt, reverse = false } = Astro.props;
---

<Section id={id} divider>
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16" data-reveal>
    <div class={reverse ? 'lg:order-2' : ''}>
      <Eyebrow>{eyebrow}</Eyebrow>
      <SectionHeading heading={heading} class="mt-4" />
      <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{body}</p>
      <Button href={href} size="lg" class="mt-8">
        {cta}
        <Icons name="arrow-up-right" size={16} />
      </Button>
    </div>

    <div class={reverse ? 'lg:order-1' : ''}>
      <div class="grid grid-cols-3 gap-3">
        {
          images.map((image, index) => (
            <Image
              src={image}
              alt={index === 0 ? imageAlt : ''}
              widths={[180, 360]}
              sizes="(min-width: 1024px) 180px, 30vw"
              format="webp"
              loading="lazy"
              class:list={[
                'float-slow w-full rounded-xl border border-line bg-surface',
                index % 2 === 1 && 'translate-y-4',
              ]}
            />
          ))
        }
      </div>
    </div>
  </div>
</Section>

<style>
  /* Staggered so the tiles drift independently. Done here rather than with an
     inline style attribute, which the site's Content-Security-Policy forbids. */
  .float-slow:nth-child(2) {
    animation-delay: 0.6s;
  }
  .float-slow:nth-child(3) {
    animation-delay: 1.2s;
  }
  .float-slow:nth-child(4) {
    animation-delay: 1.8s;
  }
  .float-slow:nth-child(5) {
    animation-delay: 2.4s;
  }
  .float-slow:nth-child(6) {
    animation-delay: 3s;
  }
</style>
