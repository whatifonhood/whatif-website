---
import type { Locale } from '../../config/site.ts';
import { ECOSYSTEM } from '../../config/ecosystem.ts';
import { getCopy } from '../../content/index.ts';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icons from '../ui/Icons.astro';
import ToolLogo from '../ui/ToolLogo.astro';

/** The tools we use, each with its own logo served from this origin. */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<Section id="ecosystem" divider>
  <div class="max-w-2xl">
    <Eyebrow>{copy.ecosystem.eyebrow}</Eyebrow>
    <SectionHeading heading={copy.ecosystem.heading} class="mt-4" />
    <p class="mt-5 text-lg leading-relaxed text-muted">{copy.ecosystem.intro}</p>
  </div>

  <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
    {
      ECOSYSTEM.map((tool) => (
        <a
          href={tool.url}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-hover shimmer group flex flex-col p-5"
        >
          <div class="flex items-start justify-between">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-white/[0.06] ring-1 ring-inset ring-white/10">
              <ToolLogo name={tool.logo} size={30} class="h-[30px] w-[30px]" />
            </span>
            <Icons
              name="arrow-up-right"
              size={14}
              class="text-faint transition-colors group-hover:text-lime"
            />
          </div>
          <h3 class="mt-4 font-display font-semibold text-ink">{tool.name}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">
            {copy.ecosystem.blurbs[tool.name]}
          </p>
        </a>
      ))
    }
  </div>
</Section>
