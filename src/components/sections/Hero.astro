---
import { Picture } from 'astro:assets';
import { MARKETS, TOKEN_SNAPSHOT, BURNED_PERCENT, type Locale } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import { formatCompact, formatPercent, formatUsd } from '../../lib/format.ts';
import Button from '../ui/Button.astro';
import Icons from '../ui/Icons.astro';
import heroArt from '../../assets/hero-cosmos.png';

/**
 * The hero. The artwork is a real <img> in the static HTML — not a CSS
 * background — so the browser's preload scanner starts fetching it during HTML
 * parsing, before any JavaScript. That single change is most of the difference
 * between a 35-second and a 2-second LCP on a slow phone.
 *
 * The height is set in the style block below rather than with a utility, so it
 * can carry a `vh` fallback. 100vh on iOS Safari is the height of the
 * viewport with the URL bar HIDDEN, so a 100vh hero is taller than what you can
 * actually see and pushes its own buttons under the fold on first paint. `svh`
 * is the small viewport — the bar showing — so everything here is visible the
 * moment the page opens, and the extra space when the bar collapses falls
 * harmlessly below.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);

// The trailing space lives in the string so a formatter cannot drop it.
const titleLead = `${copy.hero.titleLead} `;

/** Shown immediately; src/scripts/live-stats.ts replaces them once the chain answers. */
const stats = [
  {
    key: 'price',
    label: copy.numbers.stats.price,
    value: formatUsd(TOKEN_SNAPSHOT.priceUsd, locale),
  },
  {
    key: 'marketCap',
    label: copy.numbers.stats.marketCap,
    value: formatUsd(TOKEN_SNAPSHOT.marketCapUsd, locale),
  },
  {
    key: 'burnedPercent',
    label: copy.numbers.stats.burned,
    value: formatPercent(BURNED_PERCENT, locale),
  },
  {
    key: 'holders',
    label: copy.numbers.stats.holders,
    value: formatCompact(TOKEN_SNAPSHOT.holders, locale),
  },
];
---

<section id="top" class="relative flex items-center overflow-hidden">
  <!-- Artwork.
       Contained rather than cover: covering the viewport scaled a square image
       up by about 1.6x and made it look soft. Its left edge is masked so it
       dissolves into the page instead of ending on a hard line. -->
  <div
    class="hero-art pointer-events-none absolute inset-y-0 right-0 w-full lg:w-[62%]"
    aria-hidden="true"
  >
    <Picture
      src={heroArt}
      formats={['webp']}
      fallbackFormat="webp"
      widths={[640, 768, 1024, 1440, 1840]}
      sizes="(min-width: 1024px) 62vw, 100vw"
      quality={72}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-center lg:object-contain lg:object-right"
    />
  </div>

  <!-- Scrim. The galaxy is bright; without this the buttons and the language
       switcher sit on near-white and disappear. -->
  <div
    class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(8,11,7,0.92)_0%,rgba(8,11,7,0.72)_38%,rgba(8,11,7,0.9)_70%,rgba(8,11,7,0.97)_100%)] lg:bg-[linear-gradient(90deg,rgba(8,11,7,0.99)_0%,rgba(8,11,7,0.96)_30%,rgba(8,11,7,0.72)_52%,rgba(8,11,7,0.55)_75%,rgba(8,11,7,0.8)_100%)]"
    aria-hidden="true"
  >
  </div>

  <canvas data-cosmos class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"
  ></canvas>
  <div class="bg-grid pointer-events-none absolute inset-0 opacity-25" aria-hidden="true"></div>

  <div class="hero-copy relative z-10 mx-auto w-full max-w-7xl px-5 pb-20 pt-28 sm:px-8">
    <div class="max-w-xl">
      <h1 class="display-heading text-5xl sm:text-7xl">
        {titleLead}<span class="text-lime">$IF</span><br />{copy.hero.titleTail}
      </h1>

      <p class="enter enter-1 mt-6 max-w-lg text-lg leading-relaxed text-muted sm:text-xl">
        {copy.hero.description}
      </p>

      <div class="enter enter-2 mt-8 flex flex-wrap items-center gap-3">
        <Button href={MARKETS.uniswap} external externalLabel={copy.common.externalLink} size="lg">
          {copy.hero.buy}
          <Icons name="arrow-up-right" size={16} />
        </Button>
        <Button
          href={MARKETS.dexscreener}
          variant="secondary"
          size="lg"
          external
          externalLabel={copy.common.externalLink}
        >
          {copy.hero.chart}
        </Button>
      </div>

      <p class="enter enter-2 mt-4 max-w-lg text-xs leading-relaxed text-faint">
        {copy.hero.riskNote}
      </p>

      <!-- Live figures. Snapshot values are rendered server-side so this strip is
           never empty, then replaced in place when the chain responds. -->
      <dl class="enter enter-3 mt-12 grid max-w-lg grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="min-w-0 @container flex flex-col-reverse">
              {/*
                Shrinks to fit its CELL; never breaks.
                It used to shrink with the viewport (vw), which is the wrong
                ruler: on a landscape phone or a desktop the viewport is wide but
                the cell is 110px, so "US$1217.95万" overflowed into its
                neighbour at every width above 640px. Container-query units size
                it to the column it is actually in. A price is one token and
                must stay on one line — wrapping once turned $0.00803 into
                "$0.0080" above a lone "3".
              */}
              <dt class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
                {stat.label}
              </dt>
              <dd
                data-stat={stat.key}
                class="font-display text-[clamp(0.8rem,17cqi,1.5rem)] font-black italic tabular-nums whitespace-nowrap tracking-tight text-ink"
              >
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <!--
        Where these four figures came from. The strip is live, but nothing on it
        said so, which left a visitor unable to tell a price from thirty seconds
        ago from one baked in at the last deploy. src/scripts/live-stats.ts
        swaps these two the moment the chain answers, and swaps them back if a
        later poll fails — the same element the Numbers section uses.
      -->
      <p
        data-stat-freshness
        class="enter enter-3 mt-5 font-mono text-[10px] uppercase tracking-[0.12em] text-faint"
      >
        <span data-freshness-snapshot>{copy.numbers.asOf} {TOKEN_SNAPSHOT.capturedAt}</span>
        <span data-freshness-live hidden class="inline-flex items-center gap-1.5 text-lime">
          <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>{copy.numbers.live}
        </span>
      </p>
    </div>
  </div>

  <!-- The rotating "what if…" lines, on wide screens only -->
  <div
    data-cosmic={JSON.stringify(copy.cosmic.statements)}
    class="pointer-events-none absolute inset-y-0 right-0 z-10 hidden w-1/2 select-none items-center justify-center lg:flex"
    aria-hidden="true"
  >
    <div class="flex max-w-md flex-col items-center px-12">
      <p
        class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-faint"
      >
        <span class="h-px w-6 bg-line"></span>
        {copy.cosmic.kicker}
        <span class="h-px w-6 bg-line"></span>
      </p>
      <p
        data-cosmic-line
        class="min-h-28 text-center font-display text-2xl font-semibold leading-snug text-lime transition-opacity duration-700 xl:text-3xl"
      >
        {copy.cosmic.statements[0]}
      </p>
      <div class="mt-8 flex items-center gap-2">
        {
          copy.cosmic.statements.map((_, index) => (
            <span
              data-cosmic-dot
              class:list={[
                'h-1 rounded-full transition-all duration-700',
                index === 0 ? 'w-7 bg-lime' : 'w-1.5 bg-line',
              ]}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * `svh` with a `vh` fallback underneath it.
   *
   * A browser that does not know the unit drops the whole declaration, and a
   * hero with no minimum height collapses to the height of its text. The older
   * unit is wrong by the height of the URL bar, which is a far better wrong
   * than nothing. Written here rather than through the utility because Tailwind
   * emits one declaration and there is nowhere to put the fallback.
   */
  #top {
    min-height: 100vh;
  }
  @supports (height: 100svh) {
    #top {
      min-height: 100svh;
    }
  }

  /*
   * A short viewport is a phone on its side, not a small desktop window.
   *
   * At 342px tall the hero still reserved a full viewport plus portrait
   * padding, so it rendered 718px — two screens — and the description, the Buy
   * button and the live figures were all below the fold with nothing but the
   * headline visible. Height, not width, is the thing to key off here.
   */
  @media (max-height: 480px) and (orientation: landscape) {
    #top {
      min-height: auto;
    }
    .hero-copy {
      padding-top: 4.5rem;
      padding-bottom: 2rem;
    }
    /*
     * The headline is the thing that does not fit. At the wide-screen size it
     * is 72px over three lines — 216px of a 390px-tall phone on its side, so
     * the Buy button and the figures were both below the fold with the padding
     * alone. Everything here is a size, not a hidden element: a landscape
     * reader should get less of it, not less of the page.
     */
    .hero-copy h1 {
      font-size: 2.25rem;
    }
    .hero-copy p.enter-1 {
      margin-top: 0.85rem;
      font-size: 0.95rem;
    }
    .hero-copy .enter-2 {
      margin-top: 1.1rem;
    }
    .hero-copy dl {
      margin-top: 1.35rem;
      row-gap: 0.6rem;
    }
    .hero-copy [data-stat-freshness] {
      margin-top: 0.85rem;
    }
  }

  /* The active dot grows; driven by src/scripts/cosmic-statements.ts */
  [data-cosmic-dot].is-active {
    width: 1.75rem;
    background-color: var(--color-lime);
  }
  [data-cosmic-dot]:not(.is-active) {
    width: 0.375rem;
    background-color: var(--color-line);
  }
</style>

<style>
  /* Soften the artwork's left edge so it blends into the page rather than
     stopping at the column boundary. */
  @media (min-width: 1024px) {
    .hero-art {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 26%, #000 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 26%, #000 100%);
    }
  }
</style>
