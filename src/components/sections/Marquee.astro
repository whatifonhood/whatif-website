---
import { getCopy } from '../../content/index.ts';
import type { Locale } from '../../config/site.ts';

/**
 * The scrolling band of "what if" fragments. Pure CSS: the list is duplicated
 * once and translated -50%, so the loop is seamless with no JavaScript.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
// Doubled so the loop is seamless. The second copy is aria-hidden below: a
// screen reader should hear the sentence once, not twice.
const items = [...copy.marquee, ...copy.marquee];
---

<div class="relative overflow-hidden border-y border-line bg-surface/50 py-5">
  <div
    class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(90deg,var(--color-void),transparent_15%,transparent_85%,var(--color-void))]"
  >
  </div>
  <div class="flex w-max animate-marquee whitespace-nowrap will-change-transform">
    {
      items.map((item, index) => (
        <span
          aria-hidden={index >= copy.marquee.length ? 'true' : undefined}
          class:list={[
            'mx-6 font-display text-2xl font-black italic uppercase tracking-tight sm:text-3xl',
            index % 2 === 0 ? 'text-ink' : 'text-lime',
          ]}
        >
          {item}
        </span>
      ))
    }
  </div>
</div>
