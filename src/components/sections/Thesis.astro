---
import { MARKETS, type Locale } from '../../config/site.ts';
import LiveText from '../ui/LiveText.astro';
import { getCopy } from '../../content/index.ts';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Icons from '../ui/Icons.astro';

/**
 * Why $IF exists, in four cards. Two of them make factual claims, so both carry
 * a link to the on-chain proof — the rule for this site is that a claim either
 * links to evidence or does not appear.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);

/** Proof links, matched to pillars by index. */
const proofFor: Record<number, { href: string; label: string }> = {
  2: { href: MARKETS.burn, label: copy.numbers.viewOnExplorer },
  3: { href: MARKETS.contract, label: copy.numbers.viewOnExplorer },
};
---

<Section id="thesis" divider>
  <div class="max-w-2xl">
    <Eyebrow>{copy.thesis.eyebrow}</Eyebrow>
    <SectionHeading heading={copy.thesis.heading} class="mt-4" />
    <p class="mt-5 text-lg leading-relaxed text-muted">{copy.thesis.intro}</p>
  </div>

  <div class="mt-14 grid gap-4 sm:grid-cols-2" data-reveal>
    {
      copy.thesis.pillars.map((pillar, index) => {
        const proof = proofFor[index];
        /*
         * Content runs from the top; only the proof link is pushed down.
         *
         * The card used to be `justify-between`, which shares the leftover
         * height out between the number and the text. Cards in a row are the
         * same height and their bodies are not, so each shared out a different
         * amount and no two titles in a row began on the same line. `mt-auto`
         * on the link alone keeps the bottoms aligned without moving anything
         * above it.
         */
        return (
          <article class="card card-hover shimmer group flex flex-col p-6">
            <span class="font-mono text-xs text-faint">{String(index + 1).padStart(2, '0')}</span>
            <div class="mt-8">
              <h3 class="font-display text-xl font-semibold text-ink">{pillar.title}</h3>
              <LiveText
                locale={locale}
                text={pillar.body}
                class="mt-2 leading-relaxed text-muted"
              />
            </div>
            {proof && (
              <a
                href={proof.href}
                target="_blank"
                rel="noopener noreferrer"
                class="tap mt-auto inline-flex items-center gap-1.5 pt-5 font-mono text-[11px] uppercase tracking-wider text-lime hover:underline"
              >
                {proof.label}
                <Icons name="arrow-up-right" size={12} />
              </a>
            )}
          </article>
        );
      })
    }
  </div>
</Section>
