---
import type { Locale } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * The roadmap section, which is a joke, which is also the disclaimer.
 *
 * A meme coin with a serious roadmap is lying. Saying so as a gag gets the
 * warning read — and screenshotted — in a way a paragraph of legal text never is.
 * The real disclaimer follows in the footer.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
---

<Section id="roadmap" divider>
  <div class="mx-auto max-w-3xl text-center">
    <Eyebrow>{copy.roadmap.eyebrow}</Eyebrow>
    <SectionHeading heading={copy.roadmap.heading} class="mt-4" />
  </div>

  <div class="relative mx-auto mt-12 max-w-2xl" data-reveal>
    <!-- A document window, tilted a degree so it reads as an object on the page -->
    <div class="card -rotate-1 overflow-hidden shadow-[8px_8px_0_0] shadow-lime/20">
      <div class="flex items-center gap-2 border-b border-line bg-surface-2 px-4 py-3">
        <span class="h-2.5 w-2.5 rounded-full bg-faint/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-faint/40"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-faint/40"></span>
        <p class="ml-2 truncate font-mono text-[11px] text-muted">{copy.roadmap.fileName}</p>
      </div>

      <div class="px-6 py-8 sm:px-10 sm:py-10">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
          {copy.roadmap.lastEdited}
        </p>
        <ul class="mt-6 flex flex-col gap-3">
          {
            copy.roadmap.quarters.map((quarter) => (
              <li class="flex items-center gap-3 font-mono text-sm text-muted">
                <span class="grid h-4 w-4 shrink-0 place-items-center border border-line text-transparent">
                  x
                </span>
                {quarter}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- The verdict -->
    <p
      class="stamp absolute -bottom-4 right-2 rotate-[-8deg] rounded-lg border-2 border-lime px-4 py-2 font-display text-lg font-black italic uppercase tracking-tight text-lime sm:right-8 sm:text-2xl"
    >
      {copy.roadmap.stamp}
    </p>
  </div>

  <p
    class="mx-auto mt-14 max-w-xl text-center font-mono text-[11px] uppercase tracking-[0.14em] text-faint"
  >
    {copy.roadmap.footnote}
  </p>
</Section>
