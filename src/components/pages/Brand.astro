---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE, type Locale } from '../../config/site.ts';
import { LINKS, TOKEN } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import Button from '../ui/Button.astro';
import coin from '../../assets/coin.png';
import wordmark from '../../assets/wordmark.svg?url';
import kit from '../../data/brand-kit.json';

/** "20.1 MB", from the file the build wrote — never typed by hand again. */
const megabytes = (bytes: number) => `${(bytes / 1024 / 1024).toFixed(1)} MB`;

/**
 * The brand kit, as one download.
 *
 * The kit's contents are deliberately not laid out on the page: anyone here
 * wants the files, not a tour of them. Everything is built from the canonical
 * brand pack by `npm run brandkit`, so this page can never show a stale mark.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.brand;
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={page.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-brand.jpg`}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-14 sm:px-8">
    <div class="card ring-anim p-8 text-center sm:p-12">
      <!-- The three marks, so a reader knows this is the right kit before 20 MB arrives. -->
      <div class="mb-8 flex flex-wrap items-center justify-center gap-8">
        <img
          src={coin.src}
          width="96"
          height="96"
          alt="The $IF coin"
          class="h-24 w-24 rounded-full"
        />
        <img src={wordmark} width="220" height="56" alt="What $IF wordmark" class="h-12 w-auto" />
      </div>
      <Button href="/brand/what-if-brand-kit.zip" size="xl" download="what-if-brand-kit.zip">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {page.download}
      </Button>

      <p class="mx-auto mt-6 max-w-xl leading-relaxed text-muted">{page.kitNote}</p>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-faint">
        {page.fileNote.replace('{size}', megabytes(kit.kitBytes))}
      </p>
      <!-- Just the marks, for anyone who does not need 4K reference sheets. -->
      <Button
        href="/brand/what-if-marks.zip"
        variant="secondary"
        class="mt-6"
        download="what-if-marks.zip"
      >
        {page.downloadMarks.replace('{size}', megabytes(kit.marksBytes))}
      </Button>
    </div>

    <!-- The rules people actually break. Guidance, not a catalogue. -->
    <section class="mt-10">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-lime">{page.rulesTitle}</h2>
      <ul class="mt-4 flex flex-col gap-3">
        {
          page.rules.map((rule) => (
            <li class="card flex items-start gap-3 p-4 text-sm leading-relaxed text-muted">
              <span class="mt-0.5 text-lime">—</span>
              {rule}
            </li>
          ))
        }
      </ul>
    </section>

    <p
      class="mt-10 rounded-xl border-l-2 border-lime bg-lime/[0.06] px-5 py-4 text-sm leading-relaxed text-muted"
    >
      <span>{copy.footer.canonical}</span>{' '}
      <span>
        {page.contractLabel}{' '}
        <code class="break-all font-mono text-ink">{TOKEN.address}</code>
      </span>{' '}
      <span>
        {page.questions}{' '}
        <a
          href={LINKS.x}
          target="_blank"
          rel="noopener noreferrer"
          class="text-lime hover:underline"
        >
          {LINKS.xHandle}
        </a>
      </span>
    </p>
  </div>
</PageLayout>
