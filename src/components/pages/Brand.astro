---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE, type Locale } from '../../config/site.ts';
import { LINKS, TOKEN } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import Button from '../ui/Button.astro';

/**
 * The brand kit, as one download.
 *
 * The kit's contents are deliberately not laid out on the page: anyone here
 * wants the files, not a tour of them. Everything is built from the canonical
 * brand pack by `npm run brandkit`, so this page can never show a stale mark.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.brand;
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow="For anyone making $IF things"
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-brand.jpg`}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-14 sm:px-8">
    <div class="card ring-anim p-8 text-center sm:p-12">
      <Button href="/brand/what-if-brand-kit.zip" size="xl" download="what-if-brand-kit.zip">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {page.download}
      </Button>

      <p class="mx-auto mt-6 max-w-xl leading-relaxed text-muted">{page.kitNote}</p>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-faint">
        ZIP · 53 MB · no attribution needed
      </p>
    </div>

    <!-- The rules people actually break. Guidance, not a catalogue. -->
    <section class="mt-10">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.18em] text-lime">{page.rulesTitle}</h2>
      <ul class="mt-4 flex flex-col gap-3">
        {
          page.rules.map((rule) => (
            <li class="card flex items-start gap-3 p-4 text-sm leading-relaxed text-muted">
              <span class="mt-0.5 text-lime">—</span>
              {rule}
            </li>
          ))
        }
      </ul>
    </section>

    <p
      class="mt-10 rounded-xl border-l-2 border-lime bg-lime/[0.06] px-5 py-4 text-sm leading-relaxed text-muted"
    >
      {copy.footer.canonical} Contract{' '}
      <code class="break-all font-mono text-ink">{TOKEN.address}</code>. Questions, or want
      something that is not in here? <a
        href={LINKS.x}
        target="_blank"
        rel="noopener noreferrer"
        class="text-lime hover:underline">{LINKS.xHandle}</a
      >.
    </p>
  </div>
</PageLayout>
