---
import PageLayout from '../../layouts/PageLayout.astro';
import { UPDATES } from '../../config/updates.ts';
import { SITE, type Locale } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';

/**
 * Everything that has changed, newest first.
 *
 * Gives a returning visitor something they have not seen, and gives search
 * engines a reason to come back — a site that never changes gets crawled like
 * one.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.updates;

const entries = [...UPDATES].sort((a, b) => b.date.localeCompare(a.date));
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(`${iso}T12:00:00Z`),
  );
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={page.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-default.jpg`}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-12 sm:px-8">
    <ol class="flex flex-col gap-3">
      {
        entries.map((update) => (
          <li class="card p-6 sm:p-7">
            <time
              datetime={update.date}
              class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime"
            >
              {formatDate(update.date)}
            </time>
            <h2 class="mt-2 text-lg font-semibold text-ink">{update.title}</h2>
            <p class="mt-2 leading-relaxed text-muted">{update.body}</p>
            {update.href && (
              <a
                href={update.href}
                class="mt-3 inline-block font-mono text-[11px] uppercase tracking-wider text-lime hover:underline"
              >
                {page.open}
              </a>
            )}
          </li>
        ))
      }
    </ol>

    <p class="mt-10 text-center">
      <a
        href="/rss.xml"
        class="font-mono text-[11px] uppercase tracking-wider text-faint hover:text-lime"
      >
        {page.feed}
      </a>
    </p>
  </div>
</PageLayout>
