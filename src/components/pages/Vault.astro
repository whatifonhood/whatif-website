---
import { localePath } from '../../config/navigation.ts';
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE, type Locale } from '../../config/site.ts';
import { MEMES, MEME_SERIES } from '../../config/memes.ts';
import { getCopy } from '../../content/index.ts';

/**
 * The vault: every meme, downloadable.
 *
 * Thumbnails and full-size files are generated by `npm run memes` into
 * public/memes/, so this page is a straight render of src/config/memes.ts.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.memes;
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={copy.vaultTeaser.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-memes.jpg`}
>
  <div data-vault class="mx-auto w-full max-w-7xl px-5 py-14 sm:px-8">
    <!-- Filters -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap gap-2">
        <button type="button" data-vault-filter="all" aria-pressed="true" class="vault-chip">
          {page.all}
        </button>
        {
          MEME_SERIES.map((series) => (
            <button
              type="button"
              data-vault-filter={series}
              aria-pressed="false"
              class="vault-chip"
            >
              {series}
            </button>
          ))
        }
      </div>

      <div class="flex items-center gap-3">
        <label class="sr-only" for="vault-search">{page.searchLabel}</label>
        <input
          id="vault-search"
          type="search"
          data-vault-search
          placeholder={page.searchLabel}
          autocomplete="off"
          class="w-full rounded-full border border-line bg-surface px-4 py-2.5 text-sm text-ink placeholder:text-faint focus:border-lime/50 sm:w-56"
        />
        <p
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="shrink-0 font-mono text-[11px] uppercase tracking-wider text-faint"
        >
          <span data-vault-count>{MEMES.length}</span>{' '}{page.count}
        </p>
      </div>
    </div>

    <!-- Grid -->
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {
        MEMES.map((meme, index) => (
          <li
            data-vault-item
            data-series={meme.series}
            data-search={`${meme.title} ${meme.series} ${meme.slug}`}
            class="card group overflow-hidden"
          >
            <a href={localePath(`/memes/${meme.slug}/`, locale)}>
              <img
                src={`/memes/thumb/${meme.slug}.webp`}
                srcset={`/memes/thumb/${meme.slug}.webp 400w, /memes/thumb2x/${meme.slug}.webp 800w`}
                sizes="(min-width: 1024px) 300px, (min-width: 640px) 33vw, 50vw"
                alt={meme.title}
                width={meme.width}
                height={meme.height}
                loading={index < 2 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
                decoding="async"
                class="aspect-square w-full bg-surface-2 object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </a>
            <div class="flex items-center justify-between gap-2 p-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-ink">{meme.title}</p>
                <p class="font-mono text-[10px] uppercase tracking-wider text-faint">
                  {meme.series}
                </p>
              </div>
              <a
                href={`/memes/full/${meme.slug}.webp`}
                download={`whatif-${meme.slug}.webp`}
                aria-label={`${page.download} ${meme.title}`}
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-lime text-void transition-colors hover:bg-lime-pale"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </li>
        ))
      }
    </ul>

    <p data-vault-empty hidden class="py-16 text-center text-muted">{page.empty}</p>
  </div>
</PageLayout>

<style>
  .vault-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    padding: 0.5rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .vault-chip:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-lime) 45%, transparent);
  }
  .vault-chip[aria-pressed='true'] {
    background-color: var(--color-lime);
    border-color: var(--color-lime);
    color: var(--color-void);
  }
</style>

<script>
  import { initVault } from '../../scripts/vault.ts';
  initVault();
</script>
