---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE, type Locale } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';
import Icons from '../../components/ui/Icons.astro';
import Button from '../ui/Button.astro';

/**
 * The wallet lookup.
 *
 * No wallet connection anywhere on this page. An address is typed in, a public
 * balance is read back, and a card is drawn on the visitor's own device. The
 * copy says so plainly, because people are right to be wary of pasting an
 * address into a memecoin site.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.holdings;

const labels = JSON.stringify({
  errorEmpty: page.errors.empty,
  errorEns: page.errors.ens,
  errorTxHash: page.errors.txHash,
  errorPrefix: page.errors.prefix,
  errorShape: page.errors.shape,
  errorNetwork: page.errors.network,
  shareText: page.shareText,
});
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={page.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-default.jpg`}
>
  <div
    data-holdings
    data-labels={labels}
    data-bands={JSON.stringify(page.bands)}
    data-verdicts={JSON.stringify(page.verdicts)}
    class="mx-auto w-full max-w-3xl px-5 py-12 sm:px-8"
  >
    <form data-holdings-form class="flex flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="address">{page.inputLabel}</label>
      <!--
        maxlength is long enough to paste a transaction hash, so the page can
        say that is what it is rather than silently truncating it into
        something that looks like a valid address.

        text-base on a phone, not text-sm: iOS Safari zooms the whole page in
        when you focus a field whose font-size is under 16px, and it does not
        zoom back out — you are left on a page twice the width of the screen,
        having only wanted to paste an address. Every field on the site follows
        this, and a test asserts it.
      -->
      <input
        id="address"
        data-holdings-input
        type="text"
        inputmode="text"
        autocomplete="off"
        spellcheck="false"
        maxlength="80"
        placeholder="0x…"
        class="min-w-0 flex-1 rounded-full border border-field bg-surface px-5 py-3.5 font-mono text-base text-ink placeholder:text-faint focus:border-lime/60 focus:outline-none sm:text-sm"
      />
      <Button type="submit" size="lg" class="shrink-0">{page.check}</Button>
    </form>

    <p data-holdings-error hidden role="alert" class="mt-3 text-sm text-warn"></p>

    <!--
      Said before anyone types, not after. This is the question a careful person
      asks first, and the honest answer is short.
    -->
    <p class="mt-4 text-xs leading-relaxed text-faint">{page.privacy}</p>

    <!--
      role=status, because this panel IS the answer. It appeared with no live
      region of any kind and focus still on the input, so a screen reader user
      submitted an address and was told nothing at all.
    -->
    <div data-holdings-result hidden role="status" aria-live="polite" class="mt-10">
      <div class="card p-6 sm:p-8">
        <p data-out="band" class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime"></p>
        <p
          data-out="tokens"
          class="mt-3 font-display text-4xl font-black italic tabular-nums tracking-tight text-ink sm:text-5xl"
        >
        </p>
        <p class="mt-2 font-mono text-sm text-muted">
          $IF{' · '}<span data-out="usd" class="text-lime"></span>
        </p>
        <p data-out="verdict" class="mt-5 text-lg text-ink"></p>
      </div>

      <canvas
        data-holdings-card
        width="1200"
        height="675"
        role="img"
        aria-label={page.title}
        class="mt-6 w-full rounded-xl border border-line bg-surface shadow-2xl"></canvas>

      <div class="mt-5 flex flex-wrap gap-3">
        <Button href="#" size="lg" download="what-if-holdings.png" hidden data-holdings-download>
          {page.download}
        </Button>
        <Button
          href="#"
          variant="secondary"
          size="lg"
          external
          externalLabel={copy.common.externalLink}
          hidden
          data-holdings-share
        >
          <Icons name="x" size={14} />
          {page.postOnX}
        </Button>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  import { initHoldings } from '../../scripts/holdings.ts';

  initHoldings(document.documentElement.lang);
</script>
