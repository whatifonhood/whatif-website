---
import PageLayout from '../../layouts/PageLayout.astro';
import { ROADMAP, ROADMAP_STATUSES } from '../../config/roadmap.ts';
import { SITE, type Locale } from '../../config/site.ts';
import { getCopy } from '../../content/index.ts';

/**
 * The roadmap.
 *
 * Shipped work stays on the page rather than being deleted once it lands. A
 * roadmap showing only the future is a wish list; the record of what actually
 * arrived is the part that earns any trust in the rest of it.
 *
 * No dates are promised for unshipped work, deliberately.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.roadmap;

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(`${iso}T12:00:00Z`),
  );

const shippedCount = ROADMAP.filter((item) => item.status === 'shipped').length;
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={page.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-roadmap.jpg`}
>
  <div class="mx-auto w-full max-w-4xl px-5 py-12 sm:px-8">
    <p class="mb-10 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
      <span class="text-lime">{shippedCount}</span>
      {' '}{page.shippedCount}
    </p>

    <div class="flex flex-col gap-12">
      {
        ROADMAP_STATUSES.map((status) => {
          const items = ROADMAP.filter((item) => item.status === status);
          return (
            items.length > 0 && (
              <section>
                <h2 class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.16em]">
                  <span class="road-dot" data-status={status} aria-hidden="true" />
                  <span class:list={[status === 'shipped' ? 'text-faint' : 'text-lime']}>
                    {page.statuses[status]}
                  </span>
                </h2>

                <ol class="mt-5 flex flex-col gap-3">
                  {items.map((item) => (
                    <li class="card p-6" data-status={status}>
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
                        {item.date && (
                          <time
                            datetime={item.date}
                            class="font-mono text-[10px] uppercase tracking-wider text-faint"
                          >
                            {formatDate(item.date)}
                          </time>
                        )}
                      </div>
                      <p class="mt-2 leading-relaxed text-muted">{item.body}</p>
                      {item.href && (
                        <a
                          href={item.href}
                          class="mt-3 inline-block font-mono text-[11px] uppercase tracking-wider text-lime hover:underline"
                        >
                          {page.open}
                        </a>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            )
          );
        })
      }
    </div>

    <p class="mt-14 border-t border-line pt-8 text-sm leading-relaxed text-faint">
      {page.note}
    </p>
  </div>
</PageLayout>

<style>
  .road-dot {
    height: 8px;
    width: 8px;
    flex: none;
    border-radius: 999px;
    background: var(--color-lime);
  }
  .road-dot[data-status='building'] {
    box-shadow: 0 0 0 4px rgb(143 206 2 / 0.18);
  }
  .road-dot[data-status='next'] {
    background: var(--color-lime-mid, #86b50b);
  }
  .road-dot[data-status='later'] {
    background: var(--color-line);
  }
  .road-dot[data-status='shipped'] {
    background: var(--color-lime-deep, #305b05);
  }

  /* Shipped work is history, so it sits back from the work that is live. */
  .card[data-status='shipped'] {
    opacity: 0.75;
  }
  .card[data-status='shipped']:hover {
    opacity: 1;
  }
</style>
