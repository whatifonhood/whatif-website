---
import PageLayout from '../../layouts/PageLayout.astro';
import { ROADMAP, ROADMAP_STATUSES, ROADMAP_TRACKS } from '../../config/roadmap.ts';
import { SITE, type Locale } from '../../config/site.ts';
import { toolPath } from '../../config/navigation.ts';
import { getCopy } from '../../content/index.ts';
import Icons from '../ui/Icons.astro';

/**
 * The roadmap.
 *
 * Four parts, in the order they earn the reader's attention:
 *
 *   1. the record  — what has actually been delivered, as three figures
 *   2. the tracks  — what the work is for, and how far each one has got
 *   3. the work    — what is live, next and later, each with its dependency
 *                    and the condition that will make it done
 *   4. the log     — every shipped item, dated, linking to itself
 *
 * Then the terms: the four things this roadmap refuses to do. They are last
 * because they are only worth reading once you have seen the record — and they
 * are on the page rather than in a comment because a constraint nobody can read
 * is not a constraint.
 *
 * No dates are promised for unshipped work, deliberately. `npm run roadmap`
 * fails the build if one appears.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.roadmap;

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(
    new Date(`${iso}T12:00:00Z`),
  );

const shipped = ROADMAP.filter((item) => item.status === 'shipped');
const building = ROADMAP.filter((item) => item.status === 'building');

/*
 * The figures. Derived from the list rather than typed, so they cannot disagree
 * with it, and neither is measured against "now" — a static page that says
 * "3 days ago" is wrong by the following morning.
 *
 * The date of the most recent ship is a dateline under the row, not a third
 * figure in it: set at the same size as two-digit counts it wrapped onto two
 * lines and pulled the whole row off balance, and a long-form date is never the
 * same length twice across four languages.
 */
const latest =
  shipped
    .map((item) => item.date ?? '')
    .sort()
    .at(-1) ?? '';
const record = [
  { value: String(shipped.length), label: page.record.shipped },
  { value: String(building.length), label: page.record.inProgress },
];

/** Shipped per track, for the progress rail. */
const tracks = ROADMAP_TRACKS.map((track) => {
  const items = ROADMAP.filter((item) => item.track === track);
  const done = items.filter((item) => item.status === 'shipped').length;
  return { track, done, total: items.length, percent: (done / items.length) * 100 };
});

/** The log: shipped work grouped by the day it landed, newest first. */
const days = [...new Set(shipped.map((item) => item.date ?? ''))]
  .filter(Boolean)
  .sort()
  .reverse()
  .map((date) => ({ date, items: shipped.filter((item) => item.date === date) }));

/** Building, next and later. Shipped has its own section below. */
const openWork = ROADMAP_STATUSES.filter((status) => status !== 'shipped').map((status) => ({
  status,
  items: ROADMAP.filter((item) => item.status === status),
}));
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow={page.eyebrow}
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-roadmap.jpg`}
>
  <div class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8">
    <!--
      1. The record.

      Figures on the left, the date of the most recent ship on the right. The
      date is not a third figure: set at the size of a two-digit count it wraps,
      and a long-form date is never the same length twice across four languages.
    -->
    <div
      class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6 border-y border-line py-7"
    >
      <dl class="flex gap-x-12 sm:gap-x-16">
        {
          record.map((figure) => (
            <div class="flex flex-col-reverse">
              <dt class="mt-1 whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
                {figure.label}
              </dt>
              <dd class="font-display text-4xl font-black italic tabular-nums tracking-tight text-ink sm:text-5xl">
                {figure.value}
              </dd>
            </div>
          ))
        }
      </dl>
      {
        latest && (
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
            {page.record.latest}
            {' · '}
            <time datetime={latest} class="whitespace-nowrap text-muted">
              {formatDate(latest)}
            </time>
          </p>
        )
      }
    </div>

    <!-- 2. The tracks: what the work is for, and how far each has got. -->
    <ul class="mt-12 grid gap-x-8 gap-y-7 sm:grid-cols-2">
      {
        tracks.map(({ track, done, total, percent }) => (
          <li class="track">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
                {page.tracks[track].label}
              </h2>
              <p class="whitespace-nowrap font-mono text-[10px] tabular-nums tracking-wider text-faint">
                {done}/{total}
              </p>
            </div>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{page.tracks[track].objective}</p>
            {/*
              The rail is SVG, and its width is an attribute rather than a style.

              It used to be a span carrying `style="--done:57%"`. An inline style
              attribute is blocked by `style-src 'self'`, so the variable was
              never set, `width: var(--done)` fell back to auto, and every rail
              rendered full — a roadmap showing four finished tracks when only
              one was. It looked right in local preview, where no CSP is applied,
              which is exactly how it survived. An SVG width is a presentation
              attribute, not CSS: nothing has to be relaxed for it to work.
            */}
            <svg
              class="rail"
              viewBox="0 0 100 3"
              preserveAspectRatio="none"
              role="img"
              aria-label={`${page.tracks[track].label}: ${done}/${total}`}
            >
              <rect class="rail-bed" x="0" y="0" width="100" height="3" />
              <rect class="rail-done" x="0" y="0" width={percent.toFixed(2)} height="3" />
            </svg>
          </li>
        ))
      }
    </ul>

    <!--
      3. The work in flight, as a board.

      Building, next and later are three states of the same pipeline, so on a
      wide screen they sit side by side and can be compared at a glance. Stacked
      one after another they read as three unrelated lists, and the page spent
      most of its height saying so.
    -->
    <div class="mt-16 grid gap-x-7 gap-y-12 lg:grid-cols-3">
      {
        openWork.map(
          ({ status, items }) =>
            items.length > 0 && (
              <section>
                <h2 class="column-head">
                  <span class="road-dot" data-status={status} aria-hidden="true" />
                  {page.statuses[status]}
                  <span class="column-count">
                    <span class="sr-only">, </span>
                    {items.length}
                  </span>
                </h2>

                <ol class="mt-4 flex flex-col gap-3">
                  {items.map((item) => (
                    <li class="card p-5">
                      <p class="track-chip">{page.tracks[item.track].label}</p>
                      <h3 class="mt-3 font-semibold leading-snug text-ink">{item.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>

                      {(item.needs || item.signal) && (
                        <dl class="mt-4 flex flex-col gap-3 border-t border-line pt-3.5">
                          {item.needs && (
                            <div class="gate">
                              <dt>{page.needsLabel}</dt>
                              <dd>{item.needs}</dd>
                            </div>
                          )}
                          {item.signal && (
                            <div class="gate" data-signal>
                              <dt>{page.signalLabel}</dt>
                              <dd>{item.signal}</dd>
                            </div>
                          )}
                        </dl>
                      )}
                    </li>
                  ))}
                </ol>
              </section>
            ),
        )
      }
    </div>

    <!--
      4. The log.

      Fourteen shipped items as fourteen full cards was two thirds of the page,
      all at the same visual weight, which made the record of what landed harder
      to read the more there was of it. A log is a reference: dense rows under a
      date, scanned rather than studied.
    -->
    <section class="mt-20 border-t border-line pt-10">
      <h2 class="column-head">
        <span class="road-dot" data-status="shipped" aria-hidden="true"></span>
        {page.log.title}
        <span class="column-count"><span class="sr-only">, </span>{shipped.length}</span>
      </h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">{page.log.intro}</p>

      <ol class="mt-9 flex flex-col gap-9">
        {
          days.map((day) => (
            <li class="log-day">
              <time datetime={day.date} class="log-date">
                {formatDate(day.date)}
              </time>
              <ul class="log-entries">
                {day.items.map((item) => (
                  <li class="log-entry">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
                      <h3 class="font-semibold text-ink">{item.title}</h3>
                      <p class="track-chip">{page.tracks[item.track].label}</p>
                    </div>
                    <p class="mt-1.5 text-sm leading-relaxed text-muted">{item.body}</p>
                    {item.href && (
                      <a href={toolPath(item.href, locale)} class="log-link">
                        {page.open}
                        <Icons name="arrow-up-right" size={12} />
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- The terms. Last, because they are only worth reading after the record. -->
    <section class="mt-20 border-t border-line pt-10">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
        {page.terms.title}
      </h2>
      <ol class="mt-5 grid max-w-4xl gap-x-10 gap-y-4 sm:grid-cols-2">
        {
          page.terms.items.map((term, index) => (
            <li class="flex gap-4">
              <span class="mt-0.5 font-mono text-[11px] tabular-nums text-lime">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-sm leading-relaxed text-faint">{term}</p>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</PageLayout>

<style>
  .road-dot {
    height: 8px;
    width: 8px;
    flex: none;
    border-radius: 999px;
    background: var(--color-lime);
  }
  .road-dot[data-status='building'] {
    box-shadow: 0 0 0 4px rgb(143 206 2 / 0.18);
  }
  .road-dot[data-status='next'] {
    background: var(--color-lime-mid);
  }
  .road-dot[data-status='later'] {
    background: var(--color-line);
  }
  .road-dot[data-status='shipped'] {
    background: var(--color-lime-deep);
  }

  /* ---- the tracks */
  .track {
    border-left: 2px solid var(--color-line);
    padding-left: 1.15rem;
  }
  /*
   * Square ends, deliberately. `preserveAspectRatio="none"` stretches the rail
   * to whatever width the column is, and a corner radius stretches with it —
   * rounded ends would arrive as lopsided ellipses at some breakpoints and not
   * others. Square is the same shape at every width.
   */
  .rail {
    display: block;
    margin-top: 1rem;
    height: 3px;
    width: 100%;
  }
  .rail-bed {
    fill: var(--color-line);
  }
  .rail-done {
    fill: var(--color-lime);
  }

  .track-chip {
    display: inline-block;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-lime) 14%, transparent);
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-lime);
  }

  /* ---- what an unshipped item is waiting on, and what will finish it */
  .gate dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-faint);
  }
  .gate dd {
    margin-top: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .gate[data-signal] dd {
    color: var(--color-ink);
  }

  /* ---- section headings: findable at a glance, with what they hold */
  .column-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-lime);
  }
  .column-count {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    color: var(--color-faint);
  }

  /*
   * ---- the log: a date, then its entries in a column beside it.
   *
   * On a wide screen the date sits in its own gutter, so the eye can run down
   * the dates alone and stop at one. Below 60rem there is no room for a gutter
   * and it stacks, which is the same reading order with less width.
   */
  .log-day {
    display: grid;
    gap: 0.75rem 2rem;
  }
  .log-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-faint);
  }
  .log-entries {
    display: flex;
    flex-direction: column;
  }
  .log-entry {
    border-top: 1px solid var(--color-line);
    padding: 1rem 0;
  }
  .log-entry:last-child {
    padding-bottom: 0;
  }

  @media (min-width: 60rem) {
    .log-day {
      grid-template-columns: 9.5rem 1fr;
    }
    .log-date {
      padding-top: 1rem;
    }
  }

  .log-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.85rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-lime);
  }
  .log-link:hover {
    text-decoration: underline;
  }
  /* A 44px link needs no extra height on a mouse, where it is only a word. */
  @media (pointer: fine) {
    .log-link {
      min-height: 0;
      margin-top: 0.75rem;
    }
  }
</style>
