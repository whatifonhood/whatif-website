---
import PageLayout from '../../layouts/PageLayout.astro';
import { CHAIN, SITE, type Locale } from '../../config/site.ts';
import { BURNED_PERCENT, MARKETS, TOKEN, TOKEN_SNAPSHOT } from '../../config/site.ts';
import { BURNS } from '../../config/burns.ts';
import { HOLDERS, HOLDERS_CAPTURED } from '../../config/holders.ts';
import { RECIPES } from '../../lib/reproduce.ts';
import { weekInSummary } from '../../lib/week.ts';
import { getCopy } from '../../content/index.ts';
import { formatCompact, formatCount, formatPercent, formatUsd } from '../../lib/format.ts';
import Button from '../../components/ui/Button.astro';
import CopyField from '../../components/ui/CopyField.astro';
import Icons from '../../components/ui/Icons.astro';

/**
 * The dashboard.
 *
 * Every figure renders server-side from the build-time snapshot, then updates
 * in place once the market APIs answer — so the page is complete before any
 * JavaScript runs and stays readable if a request fails. See
 * src/scripts/dashboard.ts and src/lib/market.ts.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);

/**
 * The ten largest burns.
 *
 * Sorted from the committed event log rather than fetched: these are historical
 * facts that only change when a bigger burn happens, and the daily refresh
 * picks that up.
 */
const BIGGEST_BURNS = [...BURNS].sort((a, b) => b.tokens - a.tokens).slice(0, 10);

const burnDate = (seconds: number) =>
  new Date(seconds * 1000).toLocaleDateString(locale, {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  });

const page = copy.pages.stats;

const WEEK = weekInSummary();

/**
 * Where each of these can be checked, by somebody who does not trust us.
 *
 * A trust panel whose rows lead nowhere is a list of assertions. Anything with
 * no independent page to point at is left without a link rather than given one
 * that does not prove it.
 */
const CHECK_PROOF: Record<string, string | undefined> = {
  verified: `${CHAIN.explorerUrl}/address/${TOKEN.address}?tab=contract`,
  honeypot: `https://www.geckoterminal.com/robinhood/pools/${TOKEN.primaryPool}`,
  supply: `${CHAIN.explorerUrl}/token/${TOKEN.address}`,
  burn: `${CHAIN.explorerUrl}/address/${TOKEN.burnAddress}`,
  owner: `${CHAIN.explorerUrl}/address/${TOKEN.address}?tab=read_contract`,
};

const metrics = [
  {
    key: 'marketCap',
    label: copy.numbers.stats.marketCap,
    value: formatUsd(TOKEN_SNAPSHOT.marketCapUsd, locale),
  },
  {
    key: 'liquidity',
    label: copy.numbers.stats.liquidity,
    value: formatUsd(TOKEN_SNAPSHOT.liquidityUsd, locale),
  },
  {
    key: 'volume',
    label: copy.numbers.stats.volume,
    value: formatUsd(TOKEN_SNAPSHOT.volume24hUsd, locale),
  },
  {
    key: 'holders',
    label: copy.numbers.stats.holders,
    value: formatCompact(TOKEN_SNAPSHOT.holders, locale),
  },
];
---

<PageLayout
  locale={locale}
  title={page.title}
  description={page.intro}
  eyebrow="On-chain"
  heading={page.heading}
  intro={page.intro}
  socialImage={`${SITE.url}/og-stats.jpg`}
>
  <div
    data-dashboard
    data-timeframe="day"
    data-chart-type="candles"
    data-label-holders-updated={page.holdersUpdated}
    data-label-burn-mark={page.burnMark}
    data-label-check-pass={page.checkPass}
    data-label-owner-none={page.ownerNone}
    data-label-owner-some={page.ownerSome}
    data-label-window={page.windowHours}
    data-label-buy={page.buyLabel}
    data-label-sell={page.sellLabel}
    data-label-view={page.viewTx}
    data-label-failed={page.failed}
    class="mx-auto w-full max-w-7xl px-5 py-12 sm:px-8"
  >
    <p
      data-dash-status
      hidden
      class="mb-6 rounded-xl border-l-2 border-warn bg-warn/10 px-5 py-3 text-sm text-muted"
      role="status"
    >
    </p>

    <!-- Price and the chart -->
    <div class="card overflow-hidden">
      <div class="flex flex-wrap items-end justify-between gap-6 p-6 sm:p-8">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
            {page.chartTitle} · $IF / WETH
          </p>
          <p
            data-metric="price"
            class="mt-2 font-display text-[clamp(1.6rem,11vw,2.25rem)] font-black italic tabular-nums tracking-tight text-ink [overflow-wrap:anywhere] sm:text-6xl"
          >
            {formatUsd(TOKEN_SNAPSHOT.priceUsd, locale)}
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {
              (
                [
                  ['h1', '1H'],
                  ['h6', '6H'],
                  ['h24', '24H'],
                ] as const
              ).map(([window, label]) => (
                <span class="change-chip">
                  <span class="change-window">{label}</span>
                  <span data-change={window}>—</span>
                </span>
              ))
            }
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <div class="flex flex-wrap gap-1.5" role="group" aria-label={page.chartTitle}>
            {
              (['day', 'week', 'month', 'quarter', 'all'] as const).map((frame) => (
                <button
                  type="button"
                  data-timeframe={frame}
                  aria-pressed={frame === 'day' ? 'true' : 'false'}
                  class="tf-chip"
                >
                  {page.timeframes[frame]}
                </button>
              ))
            }
          </div>

          <!--
            flex-wrap, not nowrap. Eight controls at a 44px touch target are
            440px wide; the card is 333px on a phone and clips what does not fit,
            so Avg, EMA and Log were rendered past the right edge and could not
            be tapped. The clip is also why nothing looked wrong: the page never
            scrolled sideways, the buttons were simply not there.
          -->
          <div class="flex flex-wrap gap-1.5" role="group" aria-label={page.chartTypes.candles}>
            {
              (['candles', 'line'] as const).map((type) => (
                <button
                  type="button"
                  data-chart-type={type}
                  aria-pressed={type === 'candles' ? 'true' : 'false'}
                  class="tf-chip tf-chip-icon"
                  title={page.chartTypes[type]}
                >
                  {type === 'candles' ? (
                    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M7 3v4M7 17v4M17 3v7M17 16v5"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                      />
                      <rect x="4.5" y="7" width="5" height="10" rx="1" fill="currentColor" />
                      <rect x="14.5" y="10" width="5" height="6" rx="1" fill="currentColor" />
                    </svg>
                  ) : (
                    <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M3 16l5-6 4 3 4-7 5 4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  <span class="sr-only">{page.chartTypes[type]}</span>
                </button>
              ))
            }
            <button
              type="button"
              data-chart-zoom="out"
              class="chart-toggle"
              aria-label={page.zoomOut}
              title={page.zoomOut}
            >
              −
            </button>
            <button
              type="button"
              data-chart-zoom="in"
              class="chart-toggle"
              aria-label={page.zoomIn}
              title={page.zoomIn}
            >
              +
            </button>
            <button
              type="button"
              data-chart-reset
              class="chart-toggle chart-reset"
              title={page.resetZoom}
            >
              {page.resetZoom}
            </button>
            <button
              type="button"
              data-chart-average
              aria-pressed="false"
              class="chart-toggle"
              title={page.average}
            >
              {page.average}
            </button>
            <button
              type="button"
              data-chart-ema
              aria-pressed="false"
              class="chart-toggle"
              title={page.ema}
            >
              {page.ema}
            </button>
            <button
              type="button"
              data-chart-log
              aria-pressed="false"
              class="chart-toggle"
              title={page.logScale}
            >
              {page.logScale}
            </button>
          </div>
        </div>
      </div>

      <!--
        The reading line: open, high, low, close and volume for whichever candle
        the pointer is on, or the most recent one when it is not. Every chart
        worth using has one, and it is what makes the crosshair readable rather
        than decorative.
      -->
      <div data-ohlc class="ohlc-bar" aria-live="off"></div>

      <div data-chart-wrap class="chart-wrap relative border-t border-line">
        <!--
          Said, rather than left blank. When the price history cannot be
          fetched the chart drew its frame and no candles, so the page showed an
          empty dark rectangle under a full set of working controls and no
          explanation at all.
        -->
        <p
          data-chart-empty
          hidden
          class="absolute inset-0 z-10 grid place-items-center px-6 text-center font-mono text-[11px] uppercase tracking-wider text-faint"
        >
          {page.chartUnavailable}
        </p>
        <svg
          data-chart
          data-direction="up"
          viewBox="0 0 1000 320"
          preserveAspectRatio="none"
          class="chart w-full"
          role="img"
          aria-label={`${page.chartTitle} chart`}
        >
          <!-- Behind everything: the price levels the scale on the right names. -->
          <g data-grid></g>
          <g data-candles></g>
          <!-- Volume sits in its own lane under the price. -->
          <g data-volume></g>
          <!-- Overlays, drawn on the same scale as the price above. -->
          <g data-average></g>
          <g data-ema></g>
          <g data-burn-marks></g>
          <!-- The last close, so the current price is findable at a glance. -->
          <line data-last-line class="last-line" x1="0" x2="1000" opacity="0"></line>
          <line data-crosshair class="crosshair" x1="0" x2="0" y1="0" y2="320" opacity="0"></line>
          <line data-crosshair-y class="crosshair" x1="0" x2="1000" y1="0" y2="0" opacity="0"
          ></line>
        </svg>

        <!--
          Both scales are HTML, not SVG text. The chart stretches to fill its
          box (preserveAspectRatio="none"), which would squash any text drawn
          inside it — the same reason the tooltip is HTML.
        -->
        <div data-price-scale class="price-scale" aria-hidden="true"></div>
        <div data-time-axis class="time-axis" aria-hidden="true"></div>
        <div data-tip class="chart-tip" hidden></div>
      </div>

      <!--
        Drag to resize. A real slider underneath, so it also works with a
        keyboard and is announced properly — the grip is the visible handle.
      -->
      <div
        data-chart-grip
        role="slider"
        tabindex="0"
        aria-label={page.resizeChart}
        aria-orientation="vertical"
        aria-valuemin="240"
        aria-valuemax="760"
        aria-valuenow="320"
        class="chart-grip"
      >
        <span class="chart-grip-bar" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Headline metrics -->
    <dl class="mt-3 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        metrics.map((metric) => (
          <div class="card card-hover p-5 sm:p-6">
            <dd
              data-metric={metric.key}
              class="font-display text-2xl font-black italic tabular-nums tracking-tight text-lime sm:text-3xl"
            >
              {metric.value}
            </dd>
            <dt class="mt-2 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
              {metric.label}
            </dt>
          </div>
        ))
      }
    </dl>

    <!--
      Biggest trade both ways, side by side.

      These were split across two rows, which left one of them sitting alone
      beside an empty half — the most obvious hole on the page.
    -->
    <div class="mt-3 grid gap-3 lg:grid-cols-2">
      <!--
        Biggest trade both ways.

        These come from a size-filtered query, which reaches much further back
        than the recent-trades list — but a size filter is not a time window, so
        the span actually covered is printed rather than assumed.
      -->
      {
        (['buy', 'sell'] as const).map((side) => (
          <div
            data-biggest={side}
            hidden
            class:list={['card p-6 sm:p-8', side === 'buy' ? 'border-lime/30' : 'border-warn/30']}
          >
            <p
              class:list={[
                'font-mono text-[11px] uppercase tracking-[0.16em]',
                side === 'buy' ? 'text-lime' : 'text-warn',
              ]}
            >
              {side === 'buy' ? page.biggestBuy : page.biggestSell}
            </p>
            <p
              data-biggest-tokens
              class="mt-3 font-display text-3xl font-black italic tabular-nums tracking-tight text-ink sm:text-4xl"
            />
            <p class="mt-2 font-mono text-sm text-muted">
              <span data-biggest-usd class:list={[side === 'buy' ? 'text-lime' : 'text-warn']} />
              {' · '}
              <span data-biggest-wallet />
              {' · '}
              <span data-biggest-time />
            </p>
            <p
              data-biggest-window
              class="mt-1 font-mono text-[10px] uppercase tracking-wider text-faint"
            />
            <a
              data-biggest-link
              href={MARKETS.contract}
              target="_blank"
              rel="noopener noreferrer"
              class="tap mt-4 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-wider text-lime hover:underline"
            >
              {page.viewTx}
              <Icons name="arrow-up-right" size={11} />
            </a>
          </div>
        ))
      }
    </div>

    <!-- Flow and concentration -->
    <div class="mt-3 grid gap-3 lg:grid-cols-2">
      <!-- Buy / sell flow -->
      <div class="card p-6 sm:p-8">
        <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
          {page.buys} / {page.sells} · 24H
        </p>
        <!--
          Wraps rather than holding its three columns. At 200% zoom on a phone
          the row needed 210px of a 147px card, and since the page cannot scroll
          sideways the sell count was simply gone.
        -->
        <div class="mt-5 flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
          <div>
            <p
              data-metric="buys"
              class="font-display text-3xl font-black italic tabular-nums text-lime"
            >
              —
            </p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
              {page.buys}
            </p>
          </div>
          <p class="font-mono text-sm text-muted">
            <span data-metric="ratio" class="text-ink">—</span>×
          </p>
          <div class="text-right">
            <p
              data-metric="sells"
              class="font-display text-3xl font-black italic tabular-nums text-warn"
            >
              —
            </p>
            <p class="mt-1 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
              {page.sells}
            </p>
          </div>
        </div>
        <div data-flow-bar class="flow-bar mt-5" aria-hidden="true"></div>
      </div>

      <!--
        Concentration. The most useful safety number a holder can read, and one
        we could not show at all until the count stopped coming from a snapshot.
      -->
      <div data-concentration hidden class="card p-6 sm:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
            {page.concentration}
          </p>
          <!-- Showing when it was last recounted makes a stale figure look stale. -->
          <p data-holders-updated class="font-mono text-[10px] uppercase tracking-wider text-faint">
          </p>
        </div>
        <div class="conc-bar mt-4" aria-hidden="true">
          <span data-band="top10"></span>
          <span data-band="next20"></span>
          <span data-band="next20More"></span>
          <span data-band="rest"></span>
        </div>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1.5">
          {
            (['top10', 'next20', 'next20More', 'rest'] as const).map((band) => (
              <li class="flex items-center justify-between gap-2 font-mono text-[11px]">
                <span class="flex items-center gap-1.5 text-muted">
                  <i class="conc-key" data-key={band} />
                  {page.bands[band]}
                </span>
                <span data-band-value={band} class="tabular-nums text-ink" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Hourly pressure -->
    <div data-pressure hidden class="card mt-3 p-6 sm:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
        {page.pressureTitle}
      </p>
      <svg
        data-pressure-chart
        viewBox="0 0 1000 160"
        preserveAspectRatio="none"
        role="img"
        aria-label={page.pressureTitle}
        class="mt-5 h-32 w-full"
      >
        <g data-pressure-bars></g>
      </svg>
      <p class="note mt-3">
        {page.pressureNote}
      </p>
    </div>

    <!--
      Shown only to somebody who has been here before, and only after an hour.
      Everything it compares against is in their own browser — see
      src/scripts/since-last-visit.ts.
    -->
    <aside
      data-since
      hidden
      data-label-lead={page.sinceLead}
      data-label-price={page.sincePrice}
      data-label-burned={page.sinceBurned}
      data-label-holders={page.sinceHolders}
      data-label-nothing={page.sinceNothing}
      class="card mt-3 border-lime/25 p-6 sm:p-8"
    >
      <p data-since-lead class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime"></p>
      <ul data-since-list class="mt-4 space-y-2 text-lg leading-relaxed text-ink"></ul>
    </aside>

    <!--
      The week, from committed data.
      Rendered here rather than fetched: it moves when the daily refresh runs,
      not by the second, so the panel names the day it covers instead of
      pretending to be live.
    -->
    <div class="card mt-3 p-6 sm:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
        {page.weekTitle}
      </p>
      <dl class="mt-5 grid gap-x-8 gap-y-5 sm:grid-cols-3">
        {
          WEEK.priceThen !== undefined && WEEK.priceNow !== undefined && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-faint">
                {page.weekPrice}
              </dt>
              <dd
                class="mt-1.5 font-display text-2xl font-semibold tabular-nums"
                class:list={[WEEK.priceNow >= WEEK.priceThen ? 'text-lime' : 'text-warn']}
              >
                {WEEK.priceNow >= WEEK.priceThen ? '+' : ''}
                {formatPercent(((WEEK.priceNow - WEEK.priceThen) / WEEK.priceThen) * 100, locale)}
              </dd>
              <p class="mt-1 font-mono text-[11px] text-faint">
                {formatUsd(WEEK.priceThen, locale)} → {formatUsd(WEEK.priceNow, locale)}
              </p>
            </div>
          )
        }

        <div>
          <dt class="font-mono text-[11px] uppercase tracking-wider text-faint">
            {page.weekBurned}
          </dt>
          <dd class="mt-1.5 font-display text-2xl font-semibold tabular-nums text-ink">
            {formatCompact(WEEK.burnedTokens, locale)}
          </dd>
          <p class="mt-1 font-mono text-[11px] text-faint">
            {page.weekBurnCount.replace('{count}', String(WEEK.burnCount))}
          </p>
        </div>

        {
          WEEK.largestBurn && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-faint">
                {page.weekLargest}
              </dt>
              <dd class="mt-1.5 font-display text-2xl font-semibold tabular-nums text-ink">
                {formatCompact(WEEK.largestBurn.tokens, locale)}
              </dd>
              <a
                href={`${CHAIN.explorerUrl}/tx/${WEEK.largestBurn.txHash}`}
                target="_blank"
                rel="noopener noreferrer"
                class="tap mt-1 font-mono text-[11px] text-lime transition-opacity hover:opacity-70"
              >
                {page.viewTx}
                <span class="sr-only">{copy.common.externalLink}</span>
              </a>
            </div>
          )
        }
      </dl>
      <p class="note mt-5">
        {page.weekNote.replace('{date}', WEEK.to)}
      </p>
    </div>

    <!--
      Who holds it.
      The most common question about any token is whether one wallet holds all
      of it, and the honest answer needs the list rather than a percentage. The
      top row here is the burn address and the third is the pool everybody
      trades against — unlabelled, both read as whales.
    -->
    <div class="card mt-3 p-6 sm:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
        {page.holderTableTitle}
      </p>
      <p class="mt-3 max-w-2xl text-muted">{page.holderTableIntro}</p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full min-w-[32rem] border-collapse text-left font-mono text-sm">
          <thead>
            <tr class="border-b border-line text-[11px] uppercase tracking-[0.14em] text-faint">
              <th scope="col" class="py-3 pr-4 font-normal">{page.holderAddress}</th>
              <th scope="col" class="py-3 pr-4 font-normal">{page.holderWhat}</th>
              <th scope="col" class="py-3 pr-4 text-right font-normal">{page.holderTokens}</th>
              <th scope="col" class="py-3 text-right font-normal">{page.holderShare}</th>
            </tr>
          </thead>
          <tbody>
            {
              HOLDERS.map((holder) => (
                <tr class="border-b border-line/60">
                  <th scope="row" class="py-3 pr-4 font-normal">
                    <a
                      href={`${CHAIN.explorerUrl}/address/${holder.address}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="-my-3 block py-3 text-ink transition-colors hover:text-lime"
                    >
                      {holder.address.slice(0, 8)}…{holder.address.slice(-6)}
                      <span class="sr-only">{copy.common.externalLink}</span>
                    </a>
                  </th>
                  <td class="py-3 pr-4">
                    <span class="holder-tag" data-kind={holder.kind}>
                      {page.holderKinds[holder.kind]}
                    </span>
                  </td>
                  <td class="py-3 pr-4 text-right tabular-nums text-muted">
                    {formatCompact(holder.tokens, locale)}
                  </td>
                  <td class="py-3 text-right tabular-nums text-muted">
                    {formatPercent((holder.tokens / TOKEN.totalSupply) * 100, locale)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="note mt-4">
        {page.holderTableNote.replace('{date}', HOLDERS_CAPTURED)}
      </p>
    </div>

    <!-- Burn history -->
    <div class="card mt-3 p-6 sm:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
        {page.burnHistoryTitle}
      </p>
      <svg
        data-burns
        viewBox="0 0 1000 200"
        preserveAspectRatio="none"
        role="img"
        aria-label={page.burnHistoryTitle}
        class="mt-5 h-40 w-full"
      >
        <path data-burns-area class="burn-area"></path>
        <path data-burns-line class="burn-line"></path>
        <g data-burns-dots></g>
      </svg>
      <p class="note mt-3">
        {page.burnHistoryNote}
      </p>

      <!--
        The largest burns, each one linked to the transaction that made it.
        The curve above shows the shape; this names the events behind it, and
        every row can be checked on the explorer by anyone who doubts it.
      -->
      <h2 class="mt-8 font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
        {page.biggestBurnsTitle}
      </h2>
      <ol class="mt-4 divide-y divide-line/60">
        {
          BIGGEST_BURNS.map((burn, index) => (
            <li class="flex items-baseline gap-4 py-2.5">
              <span class="w-5 shrink-0 font-mono text-[11px] tabular-nums text-faint">
                {index + 1}
              </span>
              <span class="font-mono text-sm tabular-nums text-ink">
                {formatCount(burn.tokens, locale)}
                <span class="text-faint">{TOKEN.symbol}</span>
              </span>
              <span class="ml-auto font-mono text-[11px] text-faint">
                <time datetime={new Date(burn.time * 1000).toISOString()}>
                  {burnDate(burn.time)}
                </time>
              </span>
              <a
                href={`${CHAIN.explorerUrl}/tx/${burn.txHash}`}
                target="_blank"
                rel="noopener noreferrer"
                class="tap -my-2.5 shrink-0 px-2 py-2.5 font-mono text-[11px] text-lime transition-opacity hover:opacity-70"
              >
                {page.viewTx}
                <span class="sr-only">{copy.common.externalLink}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Live trades -->
    <div class="card mt-3 overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-6 py-4">
        <p
          class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.16em] text-faint"
        >
          <!--
            Hidden until a trade actually lands. It used to show from first
            paint, so a page that never reached the API sat on "Reading the
            chain…" under a live indicator — the one thing this site must not
            do, on the page whose whole argument is that the numbers are real.
          -->
          <span data-feed-live class="live-dot" hidden aria-hidden="true"></span>
          {page.feedTitle}
        </p>
        <p class="note">
          {page.feedNote}
          <span data-feed-updated class="ml-2 text-lime"></span>
          <!--
            A heartbeat, so "live" is something you can see rather than something
            the page asks you to take on trust.
          -->
          <span data-live-pulse class="live-pulse" aria-hidden="true"></span>
        </p>
      </div>

      <ul data-feed class="divide-y divide-line">
        <li
          data-feed-status
          data-label-loading={page.loading}
          data-label-unavailable={page.feedUnavailable}
          class="px-6 py-8 text-center font-mono text-[11px] uppercase tracking-wider text-faint"
        >
          {page.loading}
        </li>
      </ul>
    </div>

    <!-- Supply and burn -->
    <div class="mt-3 grid gap-3 lg:grid-cols-[2fr_1fr]">
      <div class="card border-lime/25 p-6 sm:p-8">
        <p
          data-stat="burnedExact"
          class="font-display text-4xl font-black italic tabular-nums leading-none tracking-tight text-lime sm:text-6xl"
        >
          {formatCount(TOKEN_SNAPSHOT.burnedTokens, locale)}
        </p>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
          <span data-stat="burnedPercent">{formatPercent(BURNED_PERCENT, locale)}</span>
          {' · '}{copy.numbers.burnHeadline}
        </p>
        <p class="mt-4 max-w-2xl leading-relaxed text-muted">{copy.numbers.burnBody}</p>
      </div>
      <div class="card p-6 sm:p-8">
        <p class="font-display text-2xl font-black italic tabular-nums text-ink">
          {formatCompact(TOKEN.totalSupply, locale)}
        </p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
          {copy.numbers.stats.supply}
        </p>
        <p
          data-metric="poolTokens"
          class="mt-6 font-display text-2xl font-black italic tabular-nums text-ink"
        >
          —
        </p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
          {page.poolLabel}
        </p>
      </div>
    </div>

    <!--
      Attested checks.

      Everything here is asserted by somebody who is not us and links to where it
      can be re-run. The broad "LP locked" and "ownership renounced" claims stay
      off this panel: the first is only half true, since about half the tradeable
      depth is ordinary withdrawable liquidity, and the second describes an event
      that never happened, because the contract never had an owner to give up.
      Both are set out in full in the white paper.
    -->
    <div class="card mt-3 p-6 sm:p-8">
      <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">{page.trustTitle}</p>
      <ul data-trust class="mt-5 grid gap-2.5 sm:grid-cols-2">
        {
          (['verified', 'honeypot', 'supply', 'burn', 'owner'] as const).map((check) => (
            <li data-check={check} class="trust-row">
              <span class="trust-mark" data-state="unknown" aria-hidden="true" />
              <span class="min-w-0 flex-1 text-sm text-ink">
                {CHECK_PROOF[check] ? (
                  <a
                    href={CHECK_PROOF[check]}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="tap underline decoration-line underline-offset-4 transition-colors hover:text-lime hover:decoration-lime"
                  >
                    {page.checks[check]}
                    <span class="sr-only">{copy.common.externalLink}</span>
                  </a>
                ) : (
                  page.checks[check]
                )}
              </span>
              <span
                data-check-state
                class="font-mono text-[10px] uppercase tracking-wider text-faint"
              />
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-xs leading-relaxed text-faint">{page.trustNote}</p>
    </div>

    <!--
      Reproduce every number.
      The landing page says "don't trust a website — including this one", and
      this is the means to act on it. Every command is built from the same
      constants the running code uses, so it cannot drift into being wrong
      without the site being wrong the same way.
    -->
    <details class="card mt-3 p-6 sm:p-8">
      <summary class="cursor-pointer list-none">
        <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-lime">
          {page.reproduceTitle}
        </span>
        <p class="mt-3 max-w-2xl text-muted">{page.reproduceIntro}</p>
      </summary>

      <ol class="mt-6 space-y-6">
        {
          RECIPES.map((recipe) => (
            <li>
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
                {page.reproduceLabels[recipe.key] ?? recipe.key}
              </p>
              {/* set:text on a self-closing element, so no source indentation
                  ends up inside the block — a reader copies the command, and
                  sixteen leading spaces would come with it. */}
              <pre class="reproduce-command mt-2" set:text={recipe.command} />
              <p class="mt-1.5 font-mono text-[11px] text-faint">
                {page.reproduceField} <span class="text-ink">{recipe.field}</span>
              </p>
            </li>
          ))
        }
      </ol>

      <p class="mt-8 max-w-2xl text-xs leading-relaxed text-faint">{page.reproduceNote}</p>
    </details>

    <!-- Verify it yourself -->
    <div class="mt-10 grid gap-3 lg:grid-cols-2">
      <CopyField
        label={copy.numbers.contractLabel}
        value={TOKEN.address}
        copyLabel={copy.numbers.copy}
        copiedLabel={copy.numbers.copied}
        emphasis
      />
      <CopyField
        label={page.poolLabel}
        value={TOKEN.primaryPool}
        copyLabel={copy.numbers.copy}
        copiedLabel={copy.numbers.copied}
        emphasis
      />
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <Button
        href={MARKETS.contract}
        variant="secondary"
        external
        externalLabel={copy.common.externalLink}
      >
        {page.openExplorer}
        <Icons name="arrow-up-right" size={14} />
      </Button>
      <Button
        href={MARKETS.dexscreener}
        variant="secondary"
        external
        externalLabel={copy.common.externalLink}
      >
        {page.openChart}
        <Icons name="arrow-up-right" size={14} />
      </Button>
    </div>

    <p data-stat-freshness class="mt-8 max-w-2xl font-mono text-[11px] leading-relaxed text-faint">
      <span
        data-freshness-live
        hidden
        class="mr-2 inline-flex items-center gap-1.5 uppercase tracking-wider text-lime"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>{copy.numbers.live}
      </span>
      {page.sourceNote}
    </p>
  </div>
</PageLayout>

<style>
  /* Reset only appears once there is something to reset. */
  .chart-reset {
    display: none;
  }
  [data-zoomed='true'] .chart-reset {
    display: inline-flex;
  }

  [data-chart-wrap] {
    cursor: grab;
    touch-action: pan-y;
  }
  [data-chart-wrap][data-panning='true'] {
    cursor: grabbing;
  }

  /*
   * On a phone the grip gives the page back.
   *
   * `touch-action: none` is right for a mouse: the whole 24px band is a drag
   * handle. On a touch screen it made a full-width band across the page where a
   * vertical swipe resized the chart instead of scrolling — and this sits in the
   * middle of the longest page on the site. Resizing a chart by dragging is a
   * mouse affordance; scrolling past it is not optional.
   */
  @media (pointer: coarse) {
    .chart-grip {
      touch-action: pan-y;
    }
  }

  .chart-grip {
    display: flex;
    /* 24px is the WCAG 2.5.8 minimum target, and this one sits flush against a
       pannable chart where a miss does something else entirely. */
    height: 24px;
    cursor: ns-resize;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    touch-action: none;
  }
  .chart-grip:hover .chart-grip-bar,
  .chart-grip:focus-visible .chart-grip-bar,
  .chart-grip[data-dragging='true'] .chart-grip-bar {
    background: var(--color-lime);
    width: 64px;
  }
  .chart-grip:focus-visible {
    outline: 2px solid var(--color-lime);
    outline-offset: -2px;
  }
  .chart-grip-bar {
    height: 3px;
    width: 40px;
    border-radius: 999px;
    background: var(--color-line);
    transition:
      background-color 0.15s ease,
      width 0.15s ease;
  }

  /* Height is driven by the grip; the SVG scales to whatever box it gets. */
  .chart {
    height: var(--chart-height, 16rem);
  }
  @media (min-width: 640px) {
    .chart {
      height: var(--chart-height, 20rem);
    }
  }

  /* The expanded chart. Height only — the SVG scales to whatever box it gets. */
  [data-chart-expanded='true'] .chart {
    height: 30rem;
  }
  @media (min-width: 640px) {
    [data-chart-expanded='true'] .chart {
      height: 38rem;
    }
  }

  .live-pulse {
    display: inline-block;
    height: 6px;
    width: 6px;
    border-radius: 999px;
    background: var(--color-lime);
    margin-left: 0.5rem;
    vertical-align: middle;
  }
  .live-pulse.is-beating {
    animation: live-beat 1.1s var(--ease-out-expo, ease-out);
  }
  @keyframes live-beat {
    0% {
      box-shadow: 0 0 0 0 rgb(143 206 2 / 0.55);
    }
    100% {
      box-shadow: 0 0 0 9px rgb(143 206 2 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-pulse.is-beating {
      animation: none;
    }
  }

  .crosshair {
    stroke: var(--color-lime);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.7;
    pointer-events: none;
  }

  .chart-tip {
    position: absolute;
    top: 0.75rem;
    z-index: 2;
    min-width: 8.5rem;
    transform: translateX(-50%);
    border-radius: 0.6rem;
    border: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-void) 92%, transparent);
    padding: 0.55rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-ink);
    pointer-events: none;
    backdrop-filter: blur(6px);
  }

  /* Concentration bar */
  .conc-bar {
    display: flex;
    height: 12px;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid var(--color-line);
  }
  .conc-bar span {
    width: var(--share, 0%);
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .conc-bar [data-band='top10'] {
    background: var(--color-lime);
  }
  .conc-bar [data-band='next20'] {
    background: var(--color-lime-mid);
  }
  .conc-bar [data-band='next20More'] {
    background: var(--color-lime-deep);
  }
  .conc-bar [data-band='rest'] {
    background: var(--color-line);
  }

  .conc-key {
    height: 8px;
    width: 8px;
    flex: none;
    border-radius: 2px;
  }
  .conc-key[data-key='top10'] {
    background: var(--color-lime);
  }
  .conc-key[data-key='next20'] {
    background: var(--color-lime-mid);
  }
  .conc-key[data-key='next20More'] {
    background: var(--color-lime-deep);
  }
  .conc-key[data-key='rest'] {
    background: var(--color-line);
  }

  /* Attested checks */
  .trust-row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border-radius: 0.6rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface-2);
    padding: 0.7rem 0.9rem;
  }
  .trust-mark {
    height: 9px;
    width: 9px;
    flex: none;
    border-radius: 999px;
    background: var(--color-line);
  }
  .trust-mark[data-state='pass'] {
    background: var(--color-lime);
    box-shadow: 0 0 0 3px rgb(143 206 2 / 0.16);
  }
  .trust-mark[data-state='fail'] {
    background: var(--color-warn);
  }

  /*
   * The burn curve's dots are not touch targets.
   *
   * Thirty of them sit 2.19px apart in a 285px strip, so each anchor measured
   * 1.71 x 4.8px. There is no size that makes thirty targets in 285px tappable
   * — the honest answer is that they are a picture on a phone, and the ten
   * largest burns below are the same transactions as real, labelled links.
   */
  @media (pointer: coarse) {
    [data-burns-dots] a {
      pointer-events: none;
    }
  }

  /* Burn curve */
  .burn-line {
    fill: none;
    stroke: var(--color-lime);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .burn-area {
    fill: rgb(143 206 2 / 0.12);
    stroke: none;
  }

  /*
   * The chart while a timeframe is loading.
   *
   * A tap on a chip used to give no sign anything was happening: on a slow
   * connection you pressed 7D and watched the same chart for a second and a
   * half. The chart itself dims rather than being replaced, so the candles you
   * were reading stay readable while the new ones are fetched.
   */
  [data-chart-busy] [data-chart-wrap] {
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }
  [data-chart-busy] .tf-chip,
  [data-chart-busy] .chart-toggle {
    pointer-events: none;
  }

  /* Timeframe and change chips */
  .tf-chip,
  .change-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface-2);
    padding: 0.35rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .tf-chip:hover,
  .chart-toggle:hover {
    color: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-lime) 45%, var(--color-line));
  }

  /*
   * The chart's own controls. These share the timeframe chips' shape so the row
   * reads as one set of controls rather than pills followed by loose words —
   * the class was referenced but never defined, so they were plain text.
   */
  .chart-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface-2);
    padding: 0.35rem 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .chart-toggle[aria-pressed='true'] {
    background: var(--color-lime);
    border-color: var(--color-lime);
    color: var(--color-void);
  }
  .tf-chip[aria-pressed='true'] {
    background: var(--color-lime);
    border-color: var(--color-lime);
    color: var(--color-void);
  }
  .change-chip {
    display: inline-flex;
    gap: 0.4rem;
  }
  .change-window {
    color: var(--color-faint);
  }
  [data-change][data-direction='up'] {
    color: var(--color-lime);
  }
  [data-change][data-direction='down'] {
    color: var(--color-warn);
  }

  /* Chart */
  .chart {
    overflow: visible;
    --chart-colour: var(--color-lime);
  }
  .chart[data-direction='down'] {
    --chart-colour: var(--color-warn);
  }

  /* The icon-only chart-type buttons sit tighter than the text chips. */
  .tf-chip-icon {
    display: inline-grid;
    place-items: center;
    padding: 0.35rem 0.55rem;
  }

  /*
   * On a touch screen, every one of these is a 44px target.
   *
   * They were 30px tall — over the 24px WCAG minimum, but sitting directly
   * above a chart that pans and zooms under the same finger, so a miss did not
   * do nothing, it dragged the chart. Keyed off `pointer: coarse` rather than a
   * width, because what makes a target hard to hit is the finger, not the
   * viewport: a touchscreen laptop gets the big targets and a narrow desktop
   * window does not need them.
   */
  @media (pointer: coarse) {
    .tf-chip,
    .chart-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      min-width: 44px;
      padding-inline: 0.85rem;
    }
    .tf-chip-icon {
      display: inline-flex;
      padding-inline: 0.6rem;
    }
  }

  .chart-bound {
    position: absolute;
    right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-faint);
  }

  /* Buy/sell split */
  .flow-bar {
    height: 0.4rem;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      var(--color-lime) 0 var(--buy-share, 50%),
      var(--color-warn) var(--buy-share, 50%) 100%
    );
  }

  /* A quiet pulse, so the feed reads as live rather than a static list. */
  .live-dot {
    position: relative;
    display: inline-block;
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 999px;
    background: var(--color-lime);
  }
  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--color-lime);
    animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot::after {
      animation: none;
    }
  }
</style>

<!-- These elements are created by JavaScript at runtime, so Astro's scoped
     styles never reach them (scoping is applied to markup in the template).
     They have to be global. -->
<style is:global>
  /* ---------------------------------------------------------------- chart
     The SVG stretches to fill its box, so both scales are HTML sitting in
     padding reserved on the wrapper. Anything drawn as SVG text here would be
     squashed horizontally along with the candles. */
  .chart-wrap {
    padding-right: 62px;
    padding-bottom: 22px;
  }

  .price-scale,
  .time-axis {
    position: absolute;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    color: var(--color-faint);
    pointer-events: none;
    user-select: none;
  }

  .price-scale {
    top: 0;
    right: 0;
    bottom: 22px;
    width: 62px;
  }
  .price-scale span {
    position: absolute;
    right: 8px;
    transform: translateY(-50%);
    white-space: nowrap;
  }

  .time-axis {
    left: 0;
    right: 62px;
    bottom: 0;
    height: 22px;
  }
  .time-axis span {
    position: absolute;
    transform: translateX(-50%);
    white-space: nowrap;
    top: 4px;
  }

  /* The two tags that ride the scales with the crosshair, and the one that
     marks the last close. A tag has a solid ground so it stays readable over
     whatever it lands on. */
  .scale-tag {
    position: absolute;
    padding: 1px 5px;
    border-radius: 3px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    line-height: 1.5;
    white-space: nowrap;
    pointer-events: none;
    z-index: 2;
  }
  .price-scale .scale-tag {
    right: 4px;
    transform: translateY(-50%);
    background: var(--color-ink);
    color: var(--color-void);
  }
  .price-scale .scale-tag[data-last] {
    background: var(--color-lime);
    color: var(--color-void);
  }
  .time-axis .scale-tag {
    top: 2px;
    transform: translateX(-50%);
    background: var(--color-ink);
    color: var(--color-void);
  }

  .grid-line {
    stroke: var(--color-line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: 0.55;
  }

  .last-line {
    stroke: var(--color-lime);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    vector-effect: non-scaling-stroke;
    opacity: 0.75;
  }

  .ema-line {
    fill: none;
    stroke: var(--color-info);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* The reading line above the chart. */
  .ohlc-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding: 0 1.5rem 0.85rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--color-faint);
    min-height: 1.5rem;
  }
  @media (min-width: 640px) {
    .ohlc-bar {
      padding-inline: 2rem;
    }
  }
  .ohlc-bar b {
    font-weight: 400;
    color: var(--color-faint);
  }
  .ohlc-bar span {
    color: var(--color-ink);
  }
  .ohlc-bar [data-direction='up'] {
    color: var(--color-lime);
  }
  .ohlc-bar [data-direction='down'] {
    color: var(--color-warn);
  }

  /* Reproduce panel. A command must be copyable verbatim, so it scrolls
     rather than wrapping — a wrapped curl pasted into a shell is a broken one. */
  .reproduce-command {
    overflow-x: auto;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: var(--color-void);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-muted);
    white-space: pre;
    -webkit-overflow-scrolling: touch;
  }

  /* Holder labels. Burned is the reassuring case, so it gets the site's accent;
     a pool is infrastructure, not a holding; a bare contract is neither. */
  .holder-tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
    white-space: nowrap;
  }

  .holder-tag[data-kind='burn'] {
    border-color: color-mix(in oklab, var(--color-lime) 40%, transparent);
    color: var(--color-lime);
  }

  .holder-tag[data-kind='pool'] {
    border-color: color-mix(in oklab, var(--color-ink) 25%, transparent);
    color: var(--color-muted);
  }

  /* An unidentified address gets no chip at all — an empty label is honest,
     a made-up one is not. */
  .holder-tag[data-kind='unknown'] {
    border-color: transparent;
  }

  .candle-wick {
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .candle-wick[data-rising='true'],
  .candle-body[data-rising='true'] {
    stroke: var(--color-lime);
    fill: var(--color-lime);
  }
  .candle-wick[data-rising='false'],
  .candle-body[data-rising='false'] {
    stroke: var(--color-warn);
    fill: var(--color-warn);
  }
  .candle-body {
    stroke: none;
  }

  /* Line mode. Same colours, driven by the same data-direction. */
  .line-stroke {
    fill: none;
    stroke: var(--chart-colour, #8fce02);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .line-area {
    fill: var(--chart-colour, #8fce02);
    opacity: 0.16;
    stroke: none;
  }
  .line-dot {
    fill: var(--chart-colour, #8fce02);
  }

  /* Trade feed.
     A real grid with its own column widths: the previous version let five
     values collapse into one run of text with nothing separating them. */
  .feed-row {
    display: grid;
    grid-template-columns: 3.6rem minmax(5rem, 1fr) minmax(5rem, 1fr) 7rem 4.5rem;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: background-color 0.4s ease;
  }
  .feed-row:hover {
    background: var(--color-surface-2);
  }

  .feed-kind {
    border-radius: 999px;
    padding: 0.2rem 0;
    text-align: center;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .feed-row[data-kind='buy'] .feed-kind {
    background: color-mix(in srgb, var(--color-lime) 18%, transparent);
    color: var(--color-lime);
  }
  .feed-row[data-kind='sell'] .feed-kind {
    background: rgb(240 160 106 / 0.16);
    color: var(--color-warn);
  }

  .feed-amount {
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .feed-tokens {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .feed-wallet {
    color: var(--color-faint);
    text-align: right;
  }
  .feed-wallet:hover {
    color: var(--color-lime);
    text-decoration: underline;
  }
  .feed-time {
    color: var(--color-faint);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* A trade that has appeared since the last refresh flashes once. */
  @keyframes feed-in {
    from {
      background: color-mix(in srgb, var(--color-lime) 22%, transparent);
    }
    to {
      background: transparent;
    }
  }
  .feed-row[data-new] {
    animation: feed-in 2.4s ease-out;
  }
  @media (prefers-reduced-motion: reduce) {
    .feed-row[data-new] {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .feed-row {
      grid-template-columns: 3.2rem minmax(0, 1fr) 4.2rem;
      gap: 0.6rem;
      padding: 0.65rem 1rem;
    }
    .feed-tokens,
    .feed-wallet {
      display: none;
    }
  }
</style>

<script>
  import { initLiveStats } from '../../scripts/live-stats.ts';
  import { initDashboard } from '../../scripts/dashboard.ts';
  import { initSinceLastVisit } from '../../scripts/since-last-visit.ts';

  const locale = document.documentElement.lang || 'en';
  // Listening before the dashboard runs, or the figures are announced to
  // nobody on a fast connection.
  initSinceLastVisit(locale);
  void initLiveStats(locale);
  initDashboard(locale);
</script>

