---
import PageLayout from '../../layouts/PageLayout.astro';
import { COIN_TIERS, type Coin } from '../../config/coins.ts';
import { SITE, type Locale } from '../../config/site.ts';
import { localePath } from '../../config/navigation.ts';
import { getCopy } from '../../content/index.ts';
import Button from '../ui/Button.astro';
import Icons from '../ui/Icons.astro';

/**
 * A page for each coin, so a shared link unfurls with that coin's own picture
 * and name rather than a generic card.
 *
 * The coin's NAME stays as written in every language, the way the meme titles
 * do: they are jokes, and a translated punchline is a different joke. Everything
 * around it — the rarity, the odds, the buttons — is the reader's language.
 */
interface Props {
  locale: Locale;
  coin: Coin;
}

const { locale, coin } = Astro.props;
const copy = getCopy(locale);
const page = copy.pages.pfp;

const tierLabel = page.tiers[coin.tier];
const description = `${coin.name} — a ${tierLabel} $IF coin. ${page.intro}`;

const shareUrl = new URL('https://x.com/intent/post');
shareUrl.searchParams.set('text', page.shareText(coin.name, tierLabel));
shareUrl.searchParams.set('url', `${SITE.url}${localePath(`/pfp/${coin.slug}/`, locale)}`);
---

<PageLayout
  locale={locale}
  title={`${coin.name} — ${tierLabel} $IF coin`}
  description={description}
  eyebrow={copy.pfpTeaser.eyebrow}
  heading={{ lead: coin.name, accent: tierLabel }}
  intro={page.intro}
  socialImage={`${SITE.url}/coins/og/${coin.slug}.jpg`}
>
  <div class="mx-auto w-full max-w-3xl px-5 py-14 sm:px-8">
    <div class="flex flex-col items-center">
      <div class="coin-frame" data-tier={coin.tier}>
        <img
          src={`/coins/full/${coin.slug}.webp`}
          alt={`${coin.name}, a ${tierLabel} $IF coin`}
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
          class="w-full rounded-full"
        />
      </div>

      <p class="mt-8 font-mono text-[11px] uppercase tracking-[0.16em] text-faint">
        {tierLabel} · {COIN_TIERS[coin.tier].weight}% {page.odds}
      </p>
      <!-- Shown by the script below when this browser has pulled the coin. -->
      <p
        data-coin-owned={coin.slug}
        hidden
        class="mt-3 rounded-full border border-lime/40 bg-lime/10 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-lime"
      >
        {page.inCollection}
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={localePath('/pfp/', locale)} size="lg">
          {page.openGenerator}
          <Icons name="arrow-up-right" size={16} />
        </Button>
        <Button
          href={`/coins/full/${coin.slug}.png`}
          variant="secondary"
          size="lg"
          download={`what-if-${coin.slug}.png`}
        >
          {page.download}
        </Button>
        <Button
          href={shareUrl.toString()}
          variant="secondary"
          size="lg"
          external
          externalLabel={copy.common.externalLink}
        >
          <Icons name="x" size={14} />
          {page.postOnX}
        </Button>
      </div>
    </div>
  </div>
</PageLayout>

<script>
  // The collection lives in this browser only, so only this browser can say.
  const badge = document.querySelector<HTMLElement>('[data-coin-owned]');
  try {
    const raw = localStorage.getItem('whatif.pfp.v1');
    const found: unknown = raw ? (JSON.parse(raw) as { found?: unknown }).found : undefined;
    if (
      badge &&
      found &&
      typeof found === 'object' &&
      badge.dataset.coinOwned! in (found as object)
    ) {
      badge.hidden = false;
    }
  } catch {
    /* storage unavailable; the badge simply stays hidden */
  }
</script>

<style>
  .coin-frame {
    position: relative;
    width: min(100%, 340px);
  }
  .coin-frame::before {
    content: '';
    position: absolute;
    inset: -14%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--tier-glow, rgb(143 206 2 / 0.28)), transparent 68%);
    animation: glow 4s ease-in-out infinite;
  }
  .coin-frame img {
    position: relative;
  }
  [data-tier='uncommon'] {
    --tier-glow: rgb(196 220 67 / 0.3);
  }
  [data-tier='rare'] {
    --tier-glow: rgb(91 200 245 / 0.32);
  }
  [data-tier='legendary'] {
    --tier-glow: rgb(228 217 142 / 0.42);
  }
</style>
