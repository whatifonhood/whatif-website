---
/**
 * The only button on the site. Renders an <a> when given an href, a <button>
 * otherwise, so a link is always a link and a control is always a control.
 *
 * External links get target and rel automatically — no page can ever be opened
 * with access to ours.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  /** Set for links that leave the site. Adds target, rel and a screen-reader hint. */
  external?: boolean;
  externalLabel?: string;
  type?: 'button' | 'submit';
  /** Turns a link into a file download, with this as the saved file name. */
  download?: string;
  id?: string;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  externalLabel,
  type = 'button',
  id,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2.5 rounded-full font-semibold transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5';

const variants = {
  primary:
    'bg-lime text-void shadow-[0_0_0_0_rgba(143,206,2,0)] hover:bg-lime-pale hover:shadow-[0_10px_30px_-10px_rgba(143,206,2,0.55)]',
  secondary: 'border border-line bg-surface text-ink hover:border-lime/50 hover:bg-surface-2',
  ghost: 'text-muted hover:text-ink',
} as const;

const sizes = {
  md: 'px-5 py-3 text-sm',
  lg: 'px-6 py-3.5 text-base',
} as const;

const classes = [base, variants[variant], sizes[size], className];
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class:list={classes} {...externalAttrs} {...rest}>
      <slot />
      {external && externalLabel && <span class="sr-only">({externalLabel})</span>}
    </a>
  ) : (
    <button type={type} id={id} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
